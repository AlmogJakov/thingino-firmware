#!/bin/sh
# Reads current camera state and publishes changed entity values to MQTT.
# Called at startup (with "force" argument) and periodically by ha-daemon.
#
# With "force" argument: publishes ALL entities regardless of cached state.
#   Used on daemon startup to fully sync Home Assistant.
#
# Without argument: publishes ONLY entities whose value changed since last
#   publish. An idle camera produces zero MQTT traffic between polls.
#
# Config: /etc/thingino.json under "ha" key — see /usr/share/ha-common.

. /usr/share/ha-common

PRUDYNT_CONFIG="/etc/prudynt.json"

[ -n "$HA_CAMERA_ID" ] || {
	echo "ha-state: cannot determine camera MAC" >&2
	exit 1
}
[ -n "$HA_MQTT_HOST" ] || {
	echo "ha-state: ha.mqtt.host (or mqtt_sub.host) not configured" >&2
	exit 1
}

# force=1 publishes all entities; force=0 publishes only changed ones.
FORCE=0
[ "${1:-}" = "force" ] && FORCE=1

# Open a publish session: all ha_pub_state calls below are queued and flushed
# at the end with rate limiting instead of firing simultaneously.
ha_pub_begin

# Re-assert availability so a stale retained 'offline' never keeps entities
# unavailable while we're running. Published directly (not queued) so it
# reaches the broker immediately before any state values.
mpub=$(ha_mpub_cmd state)
sh -c "$mpub -r -t '${HA_AVAIL_TOPIC}' -m 'online'"

# Motion binary sensor
if ha_entity_enabled motion; then
	[ -f /run/motion/motion_alarm ] &&
		ha_pub_state motion ON "$FORCE" ||
		ha_pub_state motion OFF "$FORCE"
fi

# Motion Guard switch
if ha_entity_enabled motion_guard; then
	[ -f /run/prudynt/motion.active ] &&
		ha_pub_state motion_guard ON "$FORCE" ||
		ha_pub_state motion_guard OFF "$FORCE"
fi

# IR Cut Filter switch: 1 = filter in (day), 0 = filter out (night)
if ha_entity_enabled ircut; then
	val=$(ircut read 2>/dev/null | tr -d '\n\r')
	[ "$val" = "1" ] &&
		ha_pub_state ircut ON "$FORCE" ||
		ha_pub_state ircut OFF "$FORCE"
fi

# Day/Night select — reflects the TARGET mode (what was selected): "auto" when
# prudynt's day/night engine is enabled, otherwise the forced mode (day/night).
if ha_entity_enabled daynight; then
	# Single source of truth: the /etc/daynight.state sidecar (auto|day|night),
	# via the shared helper. The legacy prudynt.json daynight keys are dead.
	target=$(/usr/sbin/daynight-state get 2>/dev/null)
	[ "$target" = "auto" ] || [ "$target" = "day" ] || [ "$target" = "night" ] || target=day
	ha_pub_state daynight "$target" "$FORCE"
fi

# Day/Night status sensor — the ACTUAL live mode (day/night) regardless of the
# auto/day/night selection. Sourced from the value prudynt updates continuously.
if ha_entity_enabled daynight_status; then
	actual=$(awk 'NR==1 {print $1}' /run/prudynt/daynight_mode 2>/dev/null)
	ha_pub_state daynight_status "${actual:-day}" "$FORCE"
fi

# Privacy screen switch
if ha_entity_enabled privacy; then
	[ -f /run/prudynt/privacy.active ] &&
		ha_pub_state privacy ON "$FORCE" ||
		ha_pub_state privacy OFF "$FORCE"
fi

# Physical privacy switch (persisted intent in /etc/physical-privacy-state.json)
if ha_entity_enabled physical_privacy; then
	case "$(grep -o '"active":[a-z]*' /etc/physical-privacy-state.json 2>/dev/null | head -1 | grep -o '[a-z]*$')" in
		true) ha_pub_state physical_privacy ON "$FORCE" ;;
		*)    ha_pub_state physical_privacy OFF "$FORCE" ;;
	esac
fi

# Color mode switch (0=color, 1=monochrome)
if ha_entity_enabled color; then
	val=$(
		prudyntctl json - 2>/dev/null <<'EOF'
{"image":{"running_mode":null}}
EOF
	)
	mode=$(printf '%s' "$val" | grep -o '"running_mode":[^,}]*' | cut -d: -f2 | tr -d ' ')
	[ "$mode" = "0" ] &&
		ha_pub_state color ON "$FORCE" ||
		ha_pub_state color OFF "$FORCE"
fi

# IR LED 850 nm
if ha_entity_enabled ir850 && command -v light >/dev/null 2>&1; then
	val=$(light ir850 read 2>/dev/null | tr -d '\n\r')
	[ "$val" = "0" ] || [ "$val" = "1" ] &&
		{ [ "$val" = "1" ] &&
			ha_pub_state ir850 ON "$FORCE" ||
			ha_pub_state ir850 OFF "$FORCE"; }
fi

# IR LED 940 nm
if ha_entity_enabled ir940 && command -v light >/dev/null 2>&1; then
	val=$(light ir940 read 2>/dev/null | tr -d '\n\r')
	[ "$val" = "0" ] || [ "$val" = "1" ] &&
		{ [ "$val" = "1" ] &&
			ha_pub_state ir940 ON "$FORCE" ||
			ha_pub_state ir940 OFF "$FORCE"; }
fi

# White light
if ha_entity_enabled white_light && command -v light >/dev/null 2>&1; then
	val=$(light white read 2>/dev/null | tr -d '\n\r')
	[ "$val" = "0" ] || [ "$val" = "1" ] &&
		{ [ "$val" = "1" ] &&
			ha_pub_state white ON "$FORCE" ||
			ha_pub_state white OFF "$FORCE"; }
fi

# Microphone (prudynt runtime mic_muted flag, 0007 patch). ON = live (unmuted), OFF = muted.
# Read-only query (mic_muted:null), publish-on-change, no flash writes, no audio restart.
if ha_entity_enabled mic && command -v prudyntctl >/dev/null 2>&1; then
	if echo '{"audio":{"mic_muted":null}}' | prudyntctl json - 2>/dev/null | grep -qE '"mic_muted": *true'; then
		ha_pub_state mic OFF "$FORCE"
	else
		ha_pub_state mic ON "$FORCE"
	fi
fi

# Gain sensor
if ha_entity_enabled gain; then
	gain=""
	[ -f /proc/jz/isp/isp-m0 ] &&
		gain=$(awk '/total_gain/{print $NF; exit}' /proc/jz/isp/isp-m0 2>/dev/null)
	if [ -z "$gain" ] && command -v prudyntctl >/dev/null 2>&1; then
		pdata=$(
			prudyntctl json - 2>/dev/null <<'PEOF'
{"image":{"running_mode":null},"daynight":{"status":null,"enabled":null}}
PEOF
		)
		gain=$(printf '%s' "$pdata" | grep -o '"total_gain":[0-9-]*' | cut -d: -f2)
	fi
	[ -n "$gain" ] && ha_pub_state gain "$gain" "$FORCE"
fi

# WiFi RSSI sensor
if ha_entity_enabled rssi; then
	rssi=""
	if command -v iw >/dev/null 2>&1; then
		for iface in $(ls /sys/class/net/ 2>/dev/null | grep wlan); do
			rssi=$(iw "$iface" link 2>/dev/null | awk '/signal:/{print $2}')
			[ -n "$rssi" ] && break
		done
	fi
	if [ -z "$rssi" ] && [ -f /proc/net/wireless ]; then
		rssi=$(awk 'NR>2{val=$4; sub(/\..*$/, "", val); if (val+0 != 0) {print val+0; exit}}' \
			/proc/net/wireless 2>/dev/null)
	fi
	[ -n "$rssi" ] && [ "$rssi" != "0" ] && ha_pub_state rssi "$rssi" "$FORCE"
fi

# Config storage (overlay) usage — read-only df, never writes flash. Surfaces
# the jffs2 config-overlay used% so HA can alert before it fills and blocks
# config writes. Publishes only on change (ha_pub_state cache), so an idle
# camera sends nothing.
if ha_entity_enabled overlay_used; then
	# Pull the Use% field (the token ending in % whose body is all digits — this
	# skips the "Use%" header and is robust to column widths). NB: do NOT use
	# `grep -o '[0-9]*%'` here — busybox grep -o mishandles a leading can-match-
	# empty atom and returns nothing.
	used=$(df / 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i ~ /^[0-9]+%$/){sub(/%/,"",$i); print $i; exit}}')
	[ -n "$used" ] && ha_pub_state overlay_used "$used" "$FORCE"
fi

# Shabbat Ready — ON only when BOTH hold: motion detection is OFF (motion.enabled=false)
# AND day/night is NOT auto (a forced day/night mode). Either unmet -> OFF. A broken/missing
# sidecar reads as forced 'day' (NOT auto), so it can turn Shabbat ON ONLY when motion is
# also off -- never unconditionally. Read-only (jct get), publish-on-change, no flash writes.
if ha_entity_enabled shabbat; then
	mo=$(jct "$PRUDYNT_CONFIG" get motion.enabled 2>/dev/null | tr -d '"')
	# day/night "forced" (not auto) now comes from the sidecar, not prudynt.json.
	[ "$(/usr/sbin/daynight-state get 2>/dev/null)" = "auto" ] && dn=true || dn=false
	if [ "$mo" = "false" ] && [ "$dn" = "false" ]; then
		ha_pub_state shabbat ON "$FORCE"
	else
		ha_pub_state shabbat OFF "$FORCE"
	fi
fi

# Firmware update entity
if ha_entity_enabled ota; then
	mpub=$(ha_mpub_cmd state)
	installed=""
	build_date=""
	ota_check_interval=$(ha_cfg ota_check_interval)
	case "$ota_check_interval" in
		'' | *[!0-9]*) ota_check_interval=21600 ;;
	esac
	# Enforce a floor so firmware checks cannot accidentally be configured to
	# hammer api.github.com through very small intervals.
	[ "$ota_check_interval" -lt 300 ] && ota_check_interval=300

	for f in /etc/os-release /usr/lib/os-release; do
		[ -f "$f" ] || continue
		installed=$(grep '^COMMIT_ID=' "$f" 2>/dev/null | cut -d= -f2- | tr -d '"')
		[ -n "$installed" ] && {
			build_time=$(grep '^BUILD_TIME=' "$f" 2>/dev/null | cut -d= -f2- | tr -d '"')
			build_date=$(echo "$build_time" | sed 's/^\([0-9]\{4\}\)-\([0-9]\{2\}\)-\([0-9]\{2\}\).*/\1\2\3/')
			break
		}
	done
	[ -z "$installed" ] && installed="unknown"
	sh -c "$mpub -t 'cameras/${HA_CAMERA_ID}/firmware/state' -m '$installed'"

	cache_dir="/tmp/ha_ota_cache_${HA_CAMERA_ID}"
	latest_cache="${cache_dir}/latest"
	next_check_cache="${cache_dir}/next_check_epoch"
	mkdir -p "$cache_dir" 2>/dev/null

	now=$(date +%s 2>/dev/null)
	case "$now" in
		'' | *[!0-9]*) now=0 ;;
	esac

	seed=$(printf '%s' "$HA_CAMERA_ID" | cksum | awk '{print $1}')
	startup_jitter=$((seed % 301))
	period_jitter_pct=$(((seed % 21) - 10))
	period_jitter=$((ota_check_interval * period_jitter_pct / 100))
	effective_interval=$((ota_check_interval + period_jitter))
	[ "$effective_interval" -lt 300 ] && effective_interval=300
	retry_interval=900
	[ "$retry_interval" -gt "$effective_interval" ] && retry_interval="$effective_interval"

	latest=""
	[ -f "$latest_cache" ] && latest=$(cat "$latest_cache" 2>/dev/null | tr -cd '[:alnum:]._-')

	next_check=""
	[ -f "$next_check_cache" ] && next_check=$(cat "$next_check_cache" 2>/dev/null)
	case "$next_check" in
		'' | *[!0-9]*) next_check="" ;;
	esac
	if [ -z "$next_check" ] && [ "$now" -gt 0 ]; then
		next_check=$((now + startup_jitter))
		printf '%s\n' "$next_check" >"$next_check_cache"
	fi

	should_check=0
	if [ "$now" -eq 0 ] || [ -z "$next_check" ] || [ "$now" -ge "$next_check" ]; then
		should_check=1
	fi

	check_ok=0
	if [ "$should_check" = "1" ] && command -v curl >/dev/null 2>&1; then
		fetched=$(curl -sf --max-time 10 \
			"https://api.github.com/repos/themactep/thingino-firmware/releases/latest" \
			2>/dev/null | awk -F'"' '/tag_name/{print $4; exit}' |
			tr -cd '[:alnum:]._-')
		if [ -n "$fetched" ]; then
			latest="$fetched"
			check_ok=1
		fi
	fi
	if [ -n "$latest" ] && [ -n "$build_date" ]; then
		latest_date=$(echo "$latest" | sed 's/.*\([0-9]\{4\}\)-\([0-9]\{2\}\)-\([0-9]\{2\}\).*/\1\2\3/')
		[ ${#latest_date} -eq 8 ] && [ "$build_date" -ge "$latest_date" ] && latest="$installed"
	fi

	if [ "$check_ok" = "1" ]; then
		printf '%s\n' "$latest" >"$latest_cache"
	fi
	if [ "$should_check" = "1" ] && [ "$now" -gt 0 ]; then
		if [ "$check_ok" = "1" ]; then
			next_check=$((now + effective_interval))
		else
			next_check=$((now + retry_interval))
		fi
		printf '%s\n' "$next_check" >"$next_check_cache"
	fi

	sh -c "$mpub -t 'cameras/${HA_CAMERA_ID}/firmware/latest' -m '${latest:-$installed}'"
fi

# Flush all queued state publishes with rate limiting.
ha_pub_flush
