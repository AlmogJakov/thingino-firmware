#!/bin/sh
# Home Assistant MQTT integration daemon.
# Publishes discovery, starts command subscriber, polls state periodically.
# Config: /etc/thingino.json under "ha" key — see /usr/share/ha-common.

. /usr/share/ha-common

[ -n "$HA_CAMERA_ID" ] || {
	echo "ha-daemon: cannot determine camera MAC" >&2
	exit 1
}
[ -n "$HA_MQTT_HOST" ] || {
	echo "ha-daemon: ha.mqtt.host (or mqtt_sub.host) not configured" >&2
	exit 1
}

# ---------------------------------------------------------------------------
# Singleton: only one ha-daemon may run at a time.
# Use mkdir for an atomic test-and-set — unlike a plain file check+write,
# mkdir either succeeds (we own the lock) or fails (someone else does),
# with no window between the two steps.
# ---------------------------------------------------------------------------
HA_LOCK_DIR="/run/ha/daemon.lock.d"
mkdir -p /run/ha
if ! mkdir "$HA_LOCK_DIR" 2>/dev/null; then
	old_pid=$(cat "${HA_LOCK_DIR}/pid" 2>/dev/null)
	if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
		echo "ha-daemon: already running (pid $old_pid), exiting" >&2
		exit 1
	fi
	# Stale lock from a previous crash — take it over
	rm -rf "$HA_LOCK_DIR"
	mkdir "$HA_LOCK_DIR" 2>/dev/null || {
		echo "ha-daemon: cannot acquire lock" >&2
		exit 1
	}
fi
printf '%s\n' "$$" >"${HA_LOCK_DIR}/pid"

# ---------------------------------------------------------------------------
# Clear state cache on startup.
# This ensures the first ha-state call (with "force") publishes all entity
# values to fully sync Home Assistant, even if the camera was previously
# running and had a populated cache.
# ---------------------------------------------------------------------------
ha_state_cache_clear

# ---------------------------------------------------------------------------
# Publish discovery and start command subscriber
# ---------------------------------------------------------------------------
ha-discovery || {
	echo "ha-daemon: discovery failed" >&2
	exit 1
}

# Restart ha-commands automatically if it exits (e.g. transient broker disconnect)
run_commands() {
	local mpub
	while true; do
		ha-commands
		echo "ha-daemon: ha-commands exited, restarting in 5s..."
		sleep 5
		mpub=$(ha_mpub_cmd daemon)
		timeout "${HA_PUB_TIMEOUT:-4}" sh -c "$mpub -r -t '${HA_AVAIL_TOPIC}' -m 'online'" 2>/dev/null
		# On-reconnect reconcile: the subscriber just dropped (often a broker
		# restart, which may have wiped retained state). Re-assert every entity's
		# true state now, BEFORE the subscriber restarts on the next loop -- since
		# ha-commands is NOT running here, no command can be in flight to race, and
		# a concurrent periodic ha-state serialises per-entity via the Stage 2 lock.
		# This is the primary recovery for broker-side retained loss.
		ha-state force
	done
}
run_commands &
CMD_PID=$!

# First ha-state call: force-publish all entities to fully sync HA.
# Subsequent calls in the loop below only publish changed values.
ha-state force

# ---------------------------------------------------------------------------
# Camera snapshot publisher (background loop)
# Captures a JPEG snapshot, base64-encodes it, and publishes over MQTT.
# First snapshot is published immediately so HA shows an image right away.
# Subsequent publishes happen at camera_interval (default 60s, min 5s).
# ---------------------------------------------------------------------------
if ha_entity_enabled live_view; then
	CAMERA_INTERVAL=$(ha_cfg camera_interval)
	case "$CAMERA_INTERVAL" in
		'' | *[!0-9]*) CAMERA_INTERVAL=60 ;;
	esac
	[ "$CAMERA_INTERVAL" -lt 5 ] && CAMERA_INTERVAL=5

	run_camera_snapshot() {
		local mpub snap b64 first=1
		while true; do
			if [ "$first" = "1" ]; then
				first=0
			else
				sleep "$CAMERA_INTERVAL"
			fi
			mpub=$(ha_mpub_cmd camera)
			snap=$(mktemp /tmp/ha_snap.XXXXXX) || continue
			prudyntctl snapshot -c 1 >"$snap" 2>/dev/null
			if [ -s "$snap" ]; then
				b64="${snap}.b64"
				base64 "$snap" | tr -d '\n' >"$b64"
				timeout "${HA_PUB_TIMEOUT:-4}" sh -c "$mpub -t 'cameras/${HA_CAMERA_ID}/live_view/image' -f $(_sq "$b64")" 2>/dev/null
				rm -f "$b64"
			fi
			rm -f "$snap"
		done
	}
	run_camera_snapshot &
	CAMERA_PID=$!
fi

# ---------------------------------------------------------------------------
# Cleanup on exit
# ---------------------------------------------------------------------------
cleanup() {
	local mpub
	mpub=$(ha_mpub_cmd daemon)
	timeout "${HA_PUB_TIMEOUT:-4}" sh -c "$mpub -r -t '${HA_AVAIL_TOPIC}' -m 'offline'" 2>/dev/null
	kill "$CMD_PID" 2>/dev/null
	wait "$CMD_PID" 2>/dev/null
	[ -n "${CAMERA_PID:-}" ] && kill "$CAMERA_PID" 2>/dev/null
	[ -n "${CAMERA_PID:-}" ] && wait "$CAMERA_PID" 2>/dev/null
	rm -rf "$HA_LOCK_DIR"
}
on_signal() {
	trap - EXIT INT TERM
	cleanup
	exit 0
}
trap cleanup EXIT
trap on_signal INT TERM

# ---------------------------------------------------------------------------
# Periodic state + discovery refresh loop
# ---------------------------------------------------------------------------
STATE_INTERVAL=$(ha_cfg state_interval)
STATE_INTERVAL="${STATE_INTERVAL:-15}"

DISC_INTERVAL=$(ha_cfg discovery_interval)
DISC_INTERVAL="${DISC_INTERVAL:-3600}"

# Low-frequency reconcile BACKSTOP. Since the confirm-then-cache fix (ha-common
# Stages 1-3) a DROPPED publish no longer sticks: the cache is written only after
# a QoS1 PUBACK, so a failed publish leaves cache != reality and the normal 15s
# ha-state poll re-publishes it. This periodic `ha-state force` is therefore NO
# LONGER the dropped-publish heal; it only covers BROKER-SIDE retained loss
# (broker restart without persistence), which confirm-then-cache cannot detect
# (cache == reality, nothing to re-send). The primary recovery for that is the
# on-reconnect force in run_commands(); this timer is just the slow safety net,
# so it runs at 900s (was 300s). MQTT-only, no flash. A concurrent HA command is
# never overwritten by the force: the Stage 2 per-entity lock serialises them and
# the Stage 3 epoch guard makes the force skip any entity a command just changed.
RECONCILE_INTERVAL=$(ha_cfg reconcile_interval)
RECONCILE_INTERVAL="${RECONCILE_INTERVAL:-900}"

elapsed=0
since_reconcile=0
while true; do
	sleep "$STATE_INTERVAL"
	elapsed=$((elapsed + STATE_INTERVAL))
	since_reconcile=$((since_reconcile + STATE_INTERVAL))
	if [ "$since_reconcile" -ge "$RECONCILE_INTERVAL" ]; then
		# Reconcile: re-assert the true state of ALL entities (like startup),
		# healing any retained value that drifted from a dropped publish.
		ha-state force
		since_reconcile=0
	else
		# No "force": only publishes entities that changed since last poll.
		ha-state
	fi
	if [ "$elapsed" -ge "$DISC_INTERVAL" ]; then
		ha-discovery
		elapsed=0
	fi
done
