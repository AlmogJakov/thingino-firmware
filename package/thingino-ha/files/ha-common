# /usr/share/ha-common
# Sourced by ha-discovery, ha-state, ha-commands, ha-daemon.
# Provides shared camera identity, MQTT broker config, and helpers.
# Config: /etc/thingino.json under "ha" key. See /rom/thingino.json for reference.

HA_CONFIG_FILE="${HA_CONFIG_FILE:-/etc/thingino.json}"

# ---------------------------------------------------------------------------
# Config helpers
# ---------------------------------------------------------------------------

ha_cfg() {
	jct "$HA_CONFIG_FILE" get "ha.$1" 2>/dev/null | tr -d '"'
}

_ha_mqtt_cfg() {
	local key="$1"
	local val
	val=$(jct "$HA_CONFIG_FILE" get "ha.mqtt.${key}" 2>/dev/null | tr -d '"')
	if [ -z "$val" ]; then
		val=$(jct "$HA_CONFIG_FILE" get "mqtt_sub.${key}" 2>/dev/null | tr -d '"')
	fi
	printf '%s' "$val"
}

ha_entity_enabled() {
	local val
	val=$(ha_cfg "enable_$1")
	[ "$val" != "false" ]
}

# ---------------------------------------------------------------------------
# Camera identity
# ---------------------------------------------------------------------------
if [ -z "$HA_CAMERA_ID" ]; then
	HA_CAMERA_ID=$(
		for iface in eth0 wlan0 eth1; do
			addr=$(cat "/sys/class/net/$iface/address" 2>/dev/null | tr -d ':')
			[ -n "$addr" ] && { printf '%s' "$addr"; break; }
		done
	)
	export HA_CAMERA_ID
fi

if [ -z "$HA_CAMERA_HOSTNAME" ]; then
	HA_CAMERA_HOSTNAME=$(hostname 2>/dev/null || echo "thingino")
	export HA_CAMERA_HOSTNAME
fi

if [ -z "$HA_CAMERA_IP" ]; then
	HA_CAMERA_IP=$(ip route get 1 2>/dev/null \
		| awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}' | head -1)
	export HA_CAMERA_IP
fi

# ---------------------------------------------------------------------------
# MQTT broker settings
# ---------------------------------------------------------------------------
HA_MQTT_HOST=$(_ha_mqtt_cfg host)
HA_MQTT_PORT=$(_ha_mqtt_cfg port)
HA_MQTT_USER=$(_ha_mqtt_cfg username)
HA_MQTT_PASS=$(_ha_mqtt_cfg password)
HA_MQTT_SSL=$(_ha_mqtt_cfg use_ssl)
HA_MQTT_CLIENT_PREFIX=$(_ha_mqtt_cfg client_id_prefix)

HA_MQTT_PORT="${HA_MQTT_PORT:-1883}"
HA_MQTT_CLIENT_PREFIX="${HA_MQTT_CLIENT_PREFIX:-thingino-ha}"

# Delay between individual MQTT publishes within a batch session (microseconds).
# Prevents burst-flooding the broker when many entities are published at once.
HA_PUB_DELAY_US="${HA_PUB_DELAY_US:-80000}"

_sq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# ---------------------------------------------------------------------------
# MQTT command builders
# ---------------------------------------------------------------------------
ha_mpub_cmd() {
	local suffix="${1:-pub}"
	local cmd="mosquitto_pub -h $(_sq "$HA_MQTT_HOST") -p $(_sq "$HA_MQTT_PORT")"
	cmd="$cmd -i $(_sq "${HA_MQTT_CLIENT_PREFIX}-${suffix}-${HA_CAMERA_ID}")"
	[ -n "$HA_MQTT_USER" ] && cmd="$cmd -u $(_sq "$HA_MQTT_USER")"
	[ -n "$HA_MQTT_PASS" ] && cmd="$cmd -P $(_sq "$HA_MQTT_PASS")"
	[ "$HA_MQTT_SSL" = "true" ] && cmd="$cmd --capath /etc/ssl/certs"
	printf '%s' "$cmd"
}

ha_msub_cmd() {
	local suffix="${1:-sub}"
	local cmd="mosquitto_sub -h $(_sq "$HA_MQTT_HOST") -p $(_sq "$HA_MQTT_PORT")"
	cmd="$cmd -i $(_sq "${HA_MQTT_CLIENT_PREFIX}-${suffix}-${HA_CAMERA_ID}")"
	[ -n "$HA_MQTT_USER" ] && cmd="$cmd -u $(_sq "$HA_MQTT_USER")"
	[ -n "$HA_MQTT_PASS" ] && cmd="$cmd -P $(_sq "$HA_MQTT_PASS")"
	[ "$HA_MQTT_SSL" = "true" ] && cmd="$cmd --capath /etc/ssl/certs"
	printf '%s' "$cmd"
}

# ---------------------------------------------------------------------------
# State cache
#
# Tracks the last published value for each entity so ha-state only publishes
# on actual change — not on every poll cycle.
#
# Why this matters:
#   Without caching, ha-state publishes ALL entities every state_interval
#   seconds even when nothing changed. With 15 entities and a 15s interval,
#   that is 60 unnecessary MQTT connections per minute at idle.
#   With caching, an idle camera produces zero MQTT traffic between polls.
#
# Cache lives in /tmp (auto-cleared on reboot). ha-daemon clears it on
# startup so the first ha-state call always does a full publish to sync HA.
#
# State messages use the MQTT retained flag (-r) so Home Assistant recovers
# the last known state immediately after its own restart, without waiting
# for the next poll cycle.
# ---------------------------------------------------------------------------
_HA_STATE_CACHE_DIR="/tmp/ha_state_cache_${HA_CAMERA_ID}"

# Clear all cached states. Call from ha-daemon on startup.
ha_state_cache_clear() {
	rm -rf "$_HA_STATE_CACHE_DIR"
}

# Return 0 if entity state changed since the last CONFIRMED publish (caller
# should publish); return 1 if unchanged (skip). READ-ONLY: the cache is written
# only by _ha_cache_write AFTER a confirmed publish (confirm-then-cache), never
# here — so a value is remembered only once the broker has actually acked it.
_ha_state_changed() {
	local entity="$1" state="$2"
	local cache_file="$_HA_STATE_CACHE_DIR/$entity"
	local last=""
	[ -f "$cache_file" ] && last=$(cat "$cache_file" 2>/dev/null)
	[ "$state" = "$last" ] && return 1   # unchanged since last confirmed publish -> skip
	return 0                             # changed (or no cache yet) -> publish
}

# Atomically record the last CONFIRMED state for an entity by copying the exact
# bytes we just published (the publish tmpfile) into the cache. Called ONLY from
# _ha_pub_confirm on a QoS1 PUBACK, so the cache == the last broker-acked value.
_ha_cache_write() {
	local entity="$1" srcfile="$2"
	[ -n "$entity" ] || return 0
	mkdir -p "$_HA_STATE_CACHE_DIR"
	local dst="$_HA_STATE_CACHE_DIR/$entity"
	if cp -f "$srcfile" "$dst.w$$" 2>/dev/null; then
		mv -f "$dst.w$$" "$dst" 2>/dev/null || rm -f "$dst.w$$"
	fi
}

# Per-entity command epoch (/run/ha/epoch/<entity>, tmpfs). ha-commands bumps it
# when it handles a command (BEFORE actuating/publishing); a poll captures it at
# publish-request time and _ha_pub_confirm re-checks it UNDER the lock, so a stale
# poll snapshot can never overwrite a newer command result. Reads "0" when the
# entity has never been commanded, so an un-commanded entity publishes normally.
_ha_epoch_read() {
	local v
	v=$(cat "/run/ha/epoch/$1" 2>/dev/null)
	printf '%s' "${v:-0}"
}

# Bump an entity's command epoch (atomic temp+mv; ha-commands is the single
# serial writer, so a plain increment cannot race).
_ha_cmd_stamp() {
	[ -n "$1" ] || return 0
	mkdir -p /run/ha/epoch 2>/dev/null
	local f="/run/ha/epoch/$1" n
	n=$(cat "$f" 2>/dev/null); n=$((n + 1))
	printf '%s' "$n" > "$f.t$$" 2>/dev/null && mv -f "$f.t$$" "$f" 2>/dev/null || rm -f "$f.t$$"
}

# ---------------------------------------------------------------------------
# Publish queue
#
# ha_pub_begin / ha_pub_flush wrap publish calls into a controlled,
# rate-limited sequence to avoid burst-flooding the broker.
#
# Outside of a session, all helpers publish immediately (backward compatible).
# ---------------------------------------------------------------------------
_HA_PUB_QUEUE_FILE=""

ha_pub_begin() {
	_HA_PUB_QUEUE_FILE=$(mktemp /tmp/ha_pubq.XXXXXX) || _HA_PUB_QUEUE_FILE=""
}

# ---------------------------------------------------------------------------
# Per-entity publish lock (/run/ha/pub/<entity>.d, tmpfs).
#
# Serializes the publish+cache of ONE entity across ha-commands and ha-state so
# they can't interleave or tear the cache. DIFFERENT entities use DIFFERENT lock
# dirs and never block each other. Crash-safe: a lock whose owner PID is dead is
# stolen immediately; an empty-pid or otherwise orphaned lock is stolen once it
# ages past _HA_LOCK_STALE_AGE (a live publish holds the lock <= HA_PUB_TIMEOUT,
# so a young lock is never falsely stolen). Steals are atomic (mv-aside: only one
# waiter wins). mkdir failing while the dir does NOT exist means ENOSPC/perm, not
# a held lock -> give up and publish best-effort UNLOCKED instead of busy-looping.
# Returns 0 if acquired (or entity empty => no lock needed), 1 if it gave up.
: "${_HA_LOCK_WAIT_US:=25000}"   # 25ms between attempts
: "${_HA_LOCK_TRIES:=240}"       # ~6s bounded wait (> HA_PUB_TIMEOUT)
: "${_HA_LOCK_STALE_AGE:=15}"    # steal a lock older than this many seconds

_ha_lock_aged() {
	local d="$1" mt now
	mt=$(stat -c %Y "$d" 2>/dev/null) || return 1   # can't stat -> don't age-steal
	[ -n "$mt" ] || return 1
	now=$(date +%s)
	[ "$((now - mt))" -ge "${_HA_LOCK_STALE_AGE:-15}" ]
}

_ha_lock() {
	local entity="$1"
	[ -n "$entity" ] || return 0                    # discovery/availability: no lock
	mkdir -p /run/ha/pub 2>/dev/null
	local lockd="/run/ha/pub/${entity}.d" i=0 owner
	while ! mkdir "$lockd" 2>/dev/null; do
		if [ ! -d "$lockd" ]; then                  # mkdir failed, no dir => ENOSPC/perm
			logger -t ha-mqtt "lock: cannot create $lockd (ENOSPC/err); publishing unlocked"
			return 1
		fi
		owner=$(cat "$lockd/pid" 2>/dev/null)
		if { [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; } || _ha_lock_aged "$lockd"; then
			# orphan (dead pid OR aged/empty): steal atomically -- only one waiter
			# wins the rename; the loser's mv fails and it simply retries mkdir.
			if mv "$lockd" "$lockd.stale.$$" 2>/dev/null; then
				rm -rf "$lockd.stale.$$" 2>/dev/null
				logger -t ha-mqtt "lock: stole orphan $entity (pid=${owner:-none})"
			fi
			continue
		fi
		i=$((i + 1))
		if [ "$i" -ge "${_HA_LOCK_TRIES:-240}" ]; then
			logger -t ha-mqtt "lock: wait timeout $entity; publishing unlocked"
			return 1
		fi
		usleep "${_HA_LOCK_WAIT_US:-25000}" 2>/dev/null || sleep 1
	done
	printf '%s\n' "$$" > "$lockd/pid" 2>/dev/null
	return 0
}

_ha_unlock() {
	local entity="$1"
	[ -n "$entity" ] || return 0
	rm -rf "/run/ha/pub/${entity}.d" 2>/dev/null
}

# Publish ONE message and confirm delivery. -q 1 makes mosquitto_pub block until
# the broker PUBACKs, so its exit code is real confirmation (was QoS0, exit
# ignored). Wrapped in `timeout` so an unreachable/hung broker can't block for
# minutes (validated: a publish to an unroutable host hangs until killed). On
# success — and only then — the cache is updated (confirm-then-cache); a dropped
# publish leaves the cache stale so the next poll re-publishes. Failures are
# logged. entity="" (e.g. discovery) publishes normally but is never cached.
_ha_pub_confirm() {
	local retain="$1" suffix="$2" topic="$3" tmpfile="$4" entity="$5" epoch0="$6"
	[ -f "$tmpfile" ] || return 1
	local mpub errf rc emsg locked=0
	if _ha_lock "$entity"; then locked=1; fi
	# Stale-poll guard (UNDER the lock): if a command bumped this entity's epoch
	# since epoch0 was captured, a newer ha-commands result has superseded this
	# snapshot -> skip (do NOT publish the old value). Not an error; return 0.
	if [ -n "$entity" ] && [ "$(_ha_epoch_read "$entity")" != "${epoch0:-0}" ]; then
		[ "$locked" = 1 ] && _ha_unlock "$entity"
		rm -f "$tmpfile"
		return 0
	fi
	mpub=$(ha_mpub_cmd "$suffix")
	mpub="$mpub -q 1"
	[ "$retain" = "1" ] && mpub="$mpub -r"
	errf=$(mktemp /tmp/ha_puberr.XXXXXX 2>/dev/null)
	timeout "${HA_PUB_TIMEOUT:-4}" sh -c "$mpub -t $(_sq "$topic") -f $(_sq "$tmpfile")" 2>"${errf:-/dev/null}"
	rc=$?
	if [ "$rc" = 0 ]; then
		_ha_cache_write "$entity" "$tmpfile"      # cache ONLY after confirmed PUBACK
	else
		emsg=""
		[ -s "$errf" ] && emsg=" err=$(head -c 160 "$errf" 2>/dev/null | tr '\n\r' '  ')"
		logger -t ha-mqtt "publish FAILED rc=$rc topic=$topic$emsg"
	fi
	[ "$locked" = 1 ] && [ -n "$entity" ] && _ha_unlock "$entity"
	rm -f "$tmpfile"
	[ -n "$errf" ] && rm -f "$errf"
	return "$rc"
}

_ha_queue_or_pub() {
	local retain="$1" suffix="$2" topic="$3" tmpfile="$4" entity="$5" epoch0="$6"
	if [ -n "$_HA_PUB_QUEUE_FILE" ]; then
		printf '%s|%s|%s|%s|%s|%s\n' "$retain" "$suffix" "$topic" "$tmpfile" "$entity" "$epoch0" \
			>> "$_HA_PUB_QUEUE_FILE"
	else
		_ha_pub_confirm "$retain" "$suffix" "$topic" "$tmpfile" "$entity" "$epoch0"
	fi
}

ha_pub_flush() {
	[ -n "$_HA_PUB_QUEUE_FILE" ] || return 0
	local retain suffix topic tmpfile entity epoch0
	while IFS='|' read -r retain suffix topic tmpfile entity epoch0; do
		_ha_pub_confirm "$retain" "$suffix" "$topic" "$tmpfile" "$entity" "$epoch0"
		usleep "$HA_PUB_DELAY_US" 2>/dev/null || true
	done < "$_HA_PUB_QUEUE_FILE"
	rm -f "$_HA_PUB_QUEUE_FILE"
	_HA_PUB_QUEUE_FILE=""
}

# ---------------------------------------------------------------------------
# Public publish helpers
# ---------------------------------------------------------------------------

# Publish a state value.
#
# By default, publishes only if the value changed since last time (change-
# detection via cache). Pass force=1 to always publish regardless of cache —
# used on daemon startup for a full sync and by ha-commands for optimistic
# updates after a command.
#
# All state messages use the MQTT retained flag so Home Assistant immediately
# recovers the last known state after restarting, without waiting for the
# next poll cycle.
ha_pub_state() {
	local entity="$1" state="$2" force="${3:-0}"
	[ -n "$state" ] || return 0

	# Capture the entity's command epoch NOW (publish-request time, right after the
	# caller read the state); re-checked under the lock at publish/flush.
	local epoch0
	epoch0=$(_ha_epoch_read "$entity")

	# Skip only if unchanged since the last CONFIRMED publish (read-only compare).
	# force=1 (startup/reconcile) always publishes. The cache is written by
	# _ha_cache_write ONLY after a QoS1 PUBACK, never here.
	if [ "$force" != "1" ]; then
		_ha_state_changed "$entity" "$state" || return 0
	fi

	local topic="cameras/${HA_CAMERA_ID}/${entity}/state"
	local tmpfile
	tmpfile=$(mktemp /tmp/ha_state.XXXXXX) || return 1
	printf '%s' "$state" > "$tmpfile"
	_ha_queue_or_pub 1 state "$topic" "$tmpfile" "$entity" "$epoch0"
}

# Publish a JSON state payload with the same change-detection logic.
ha_pub_state_json() {
	local entity="$1" payload="$2" force="${3:-0}"

	local epoch0
	epoch0=$(_ha_epoch_read "$entity")

	if [ "$force" != "1" ]; then
		_ha_state_changed "$entity" "$payload" || return 0
	fi

	local topic="cameras/${HA_CAMERA_ID}/${entity}/state"
	local tmpfile
	tmpfile=$(mktemp /tmp/ha_state.XXXXXX) || return 1
	printf '%s' "$payload" > "$tmpfile"
	_ha_queue_or_pub 1 state "$topic" "$tmpfile" "$entity" "$epoch0"
}

# Clear a discovery topic (empty retained message removes entity from HA).
ha_clear_disc() {
	local component="$1" object_id="$2"
	local disc_prefix
	disc_prefix=$(ha_cfg discovery_prefix)
	disc_prefix="${disc_prefix:-homeassistant}"
	local topic="${disc_prefix}/${component}/thingino_${HA_CAMERA_ID}/${object_id}/config"
	local mpub
	mpub=$(ha_mpub_cmd disc)
	sh -c "$mpub -r -t $(_sq "$topic") -n" 2>/dev/null
	usleep "$HA_PUB_DELAY_US" 2>/dev/null || true
}

# Publish a retained discovery payload.
ha_pub_disc() {
	local component="$1" object_id="$2" payload="$3"
	local disc_prefix
	disc_prefix=$(ha_cfg discovery_prefix)
	disc_prefix="${disc_prefix:-homeassistant}"
	local topic="${disc_prefix}/${component}/thingino_${HA_CAMERA_ID}/${object_id}/config"
	local tmpfile
	tmpfile=$(mktemp /tmp/ha_disc.XXXXXX) || return 1
	printf '%s' "$payload" > "$tmpfile"
	_ha_queue_or_pub 1 disc "$topic" "$tmpfile"
}

ha_json_escape() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

HA_AVAIL_TOPIC="cameras/${HA_CAMERA_ID}/status"
