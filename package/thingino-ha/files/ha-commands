#!/bin/sh
# Subscribes to Home Assistant command topics and dispatches to camera scripts.
# Runs as a background process inside ha-daemon.
# Publishes state immediately after each command (optimistic update) so HA
# reflects changes instantly without waiting for ha-state's next poll cycle.

. /usr/share/ha-common

[ -n "$HA_CAMERA_ID" ] || { echo "ha-commands: cannot determine camera MAC" >&2; exit 1; }
[ -n "$HA_MQTT_HOST" ] || { echo "ha-commands: ha.mqtt.host (or mqtt_sub.host) not configured" >&2; exit 1; }

# Disable prudynt's automatic day/night management before manual hardware control.
# Without this, prudynt may immediately undo hardware changes.
prudynt_disable_auto() {
	printf '{"daynight":{"enabled":false}}' | prudyntctl json - >/dev/null 2>&1
}

# Physical-privacy interlock for day/night-class changes. Returns 0 if the caller
# should proceed; non-zero if physical privacy intercepted the command (it was
# transitioning -> dropped, or armed -> privacy cancelled). On intercept we
# re-sync HA so the switches reflect the cancellation.
physpriv_intercept() {
	[ -x /sbin/physical-privacy ] || return 0
	/sbin/physical-privacy guard && return 0
	{ sleep 2; ha-state; } &
	return 1
}

# PTZ relative move via the local motors driver (no auth, no HTTP).
# Mapping per /sbin/ptz-ctrl: Up = -y, Down = +y, Left = -x, Right = +x.
# Home = motors -r. Step magnitude is configurable via the PTZ_STEP env var.
PTZ_STEP="${PTZ_STEP:-100}"
ptz_move() {
	command -v motors >/dev/null 2>&1 || return 0
	motors -d g -x "$1" -y "$2" >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# Subscriber command
# LWT ensures HA sees 'offline' if this connection drops unexpectedly.
# ---------------------------------------------------------------------------
MSUB=$(ha_msub_cmd cmd)
# -v prints "topic payload" on each line — do NOT add -F: it was introduced in
# mosquitto 1.5 and its absence causes mosquitto_sub to exit immediately on
# older embedded builds, triggering the infinite reconnect loop.
MSUB="$MSUB -v"
# LWT: broker notifies HA immediately if this connection drops (no retain —
# ha-state re-asserts 'online' on reconnect so we don't leave a sticky offline)
MSUB="$MSUB --will-topic ${HA_AVAIL_TOPIC} --will-payload offline --will-qos 1"
MSUB="$MSUB -t 'cameras/${HA_CAMERA_ID}/+/set'"

# ---------------------------------------------------------------------------
# Command dispatcher
# After each command we publish the new state directly so HA gets instant
# feedback instead of waiting for the next ha-state poll cycle.
# ---------------------------------------------------------------------------
dispatch() {
	local topic="$1"
	local payload="$2"

	# cameras/<id>/entity/set → entity
	local entity
	entity=$(printf '%s' "$topic" \
		| sed "s|cameras/${HA_CAMERA_ID}/||; s|/set\$||; s|/|_|g")

	# Stale-poll protection (Stage 3): bump this entity's command epoch BEFORE
	# actuating/publishing, so any ha-state poll that already read this entity
	# skips its now-stale snapshot at flush and lets this command's result win.
	_ha_cmd_stamp "$entity"

	case "$entity" in

		motion_guard)
			# Use prudyntctl directly — calling 'motion enable' goes through the
			# motion event script which has a singleton guard and may fail silently
			# if a motion event is already in progress.
			case "$payload" in
				on|ON|1|true)
					printf '{"motion":{"enabled":true}}' | prudyntctl json - >/dev/null 2>&1
					# write-on-change: prudyntctl (above) already applied it live in RAM; only
					# rewrite prudynt.json (a ~9KB flash rewrite + jffs2 churn) when the persisted
					# value actually differs, so an HA automation repeatedly toggling Motion Guard
					# cannot churn/fill the tiny jffs2 overlay.
					[ "$(jct /etc/prudynt.json get motion.enabled 2>/dev/null | tr -d '" ')" = "true" ] \
						|| jct /etc/prudynt.json set motion.enabled true >/dev/null 2>&1
					ha_pub_state motion_guard ON
					;;
				off|OFF|0|false)
					printf '{"motion":{"enabled":false}}' | prudyntctl json - >/dev/null 2>&1
					# write-on-change (see the ON branch above)
					[ "$(jct /etc/prudynt.json get motion.enabled 2>/dev/null | tr -d '" ')" = "false" ] \
						|| jct /etc/prudynt.json set motion.enabled false >/dev/null 2>&1
					ha_pub_state motion_guard OFF
					;;
			esac
			;;

		ircut)
			# IR-cut is a day/night-class control, so behave like daynight/color: a manual
			# change while physical privacy is on means "cancel privacy" (drop this command;
			# physpriv_intercept re-syncs HA itself). When privacy is off it runs normally.
			# (No emitter is lit either way — the light guard is the warming enforcement.)
			if physpriv_intercept; then
				prudynt_disable_auto
				case "$payload" in
					on|ON|day|1)    ircut on;  ha_pub_state ircut ON  ;;
					off|OFF|night|0) ircut off; ha_pub_state ircut OFF ;;
				esac
				{ sleep 2; ha-state; } &
			fi
			;;

		daynight)
			# Route through the agent (thingino-agentctl): updates prudynt
			# runtime AND persisted config, and physically switches via the
			# configured executor. Supports auto / day / night.
			# A manual day/night change while physical privacy is on means
			# "cancel privacy" (drop this command); it re-syncs HA itself.
			if physpriv_intercept; then
				case "$payload" in
					auto|day|night)
						thingino-agentctl daynight "$payload" >/dev/null 2>&1
						ha_pub_state daynight "$payload"
						;;
				esac
				# Daynight changes ircut/color/ir850 — re-sync all states after settle
				{ sleep 2; ha-state; } &
			fi
			;;

		privacy)
			case "$payload" in
				on|ON|1)
					privacy on
					ha_pub_state privacy ON
					;;
				off|OFF|0)
					privacy off
					ha_pub_state privacy OFF
					;;
			esac
			;;

		physical_privacy)
			# Physical privacy: tilt the lens away + force day (no overlay).
			# Trigger the lens move FIRST, backgrounded so its ~0.5s guard/LED/mic
			# setup never delays HA feedback; publish the optimistic state right
			# after, then re-sync once the move settles for final correctness.
			case "$payload" in
				on|ON|1)
					/sbin/physical-privacy on >/dev/null 2>&1 &
					ha_pub_state physical_privacy ON
					{ sleep 3; ha-state; } &
					;;
				off|OFF|0)
					/sbin/physical-privacy off >/dev/null 2>&1 &
					ha_pub_state physical_privacy OFF
					{ sleep 3; ha-state; } &
					;;
			esac
			;;

		color)
			# running_mode: 0 = color, 1 = monochrome. This is a day/night-class
			# change, so it is interlocked with physical privacy.
			if physpriv_intercept; then
				case "$payload" in
					on|ON|1)
						printf '{"daynight":{"enabled":false},"image":{"running_mode":0}}' \
							| prudyntctl json - >/dev/null 2>&1
						ha_pub_state color ON
						;;
					off|OFF|0)
						printf '{"daynight":{"enabled":false},"image":{"running_mode":1}}' \
							| prudyntctl json - >/dev/null 2>&1
						ha_pub_state color OFF
						;;
				esac
			fi
			;;

		ir850)
			prudynt_disable_auto
			case "$payload" in
				on|ON|1)  light ir850 on  ;;
				off|OFF|0) light ir850 off ;;
			esac
			# Publish the ACTUAL GPIO state, not the requested one: while physical
			# privacy is active the light guard refuses the turn-on (exits 0), so a
			# requested ON physically stays OFF — read it back so HA never desyncs.
			if [ "$(light ir850 read 2>/dev/null)" = "1" ]; then ha_pub_state ir850 ON; else ha_pub_state ir850 OFF; fi
			;;

		ir940)
			prudynt_disable_auto
			case "$payload" in
				on|ON|1)  light ir940 on  ;;
				off|OFF|0) light ir940 off ;;
			esac
			if [ "$(light ir940 read 2>/dev/null)" = "1" ]; then ha_pub_state ir940 ON; else ha_pub_state ir940 OFF; fi
			;;

		white)
			# White LED is a plain visible floodlight — NOT managed by prudynt's
			# day/night engine (daynight.controls.white=false). Do NOT disable
			# auto here: that would knock the camera out of auto and surface a
			# stale force_mode (e.g. flipping to night). Just toggle the GPIO.
			case "$payload" in
				on|ON|1)  light white on  ;;
				off|OFF|0) light white off ;;
			esac
			# Read back the actual state (the privacy guard may have refused ON).
			if [ "$(light white read 2>/dev/null)" = "1" ]; then ha_pub_state white ON; else ha_pub_state white OFF; fi
			;;

		mic)
			# Microphone software mute via prudynt's runtime mic_muted flag (0007 patch):
			# the audio worker zeros captured PCM with NO restart, so the stream is
			# undisturbed. RAM only, zero flash. ON = unmuted (live), OFF = muted.
			case "$payload" in
				on|ON|1)   echo '{"audio":{"mic_muted":false}}' | prudyntctl json - >/dev/null 2>&1 ;;
				off|OFF|0) echo '{"audio":{"mic_muted":true}}'  | prudyntctl json - >/dev/null 2>&1 ;;
			esac
			# Read back the real flag (privacy mode's mute may override a manual ON).
			if echo '{"audio":{"mic_muted":null}}' | prudyntctl json - 2>/dev/null | grep -qE '"mic_muted": *true'; then ha_pub_state mic OFF; else ha_pub_state mic ON; fi
			;;

		snapshot)
			prudyntctl snapshot -c 0 > "/tmp/snap_$(date +%Y%m%d_%H%M%S).jpg" &
			;;

		reboot)
			[ "$payload" = "1" ] && reboot
			;;

		firmware)
			[ "$payload" = "install" ] && (touch /tmp/webupgrade; sysupgrade -p) &
			;;

		ptz_up)    ptz_move 0 "-$PTZ_STEP" ;;
		ptz_down)  ptz_move 0 "$PTZ_STEP" ;;
		ptz_left)  ptz_move "-$PTZ_STEP" 0 ;;
		ptz_right) ptz_move "$PTZ_STEP" 0 ;;
		ptz_home)  command -v motors >/dev/null 2>&1 && motors -r >/dev/null 2>&1 ;;

		*)
			echo "ha-commands: unknown entity '$entity' (topic: $topic)" >&2
			return
			;;
	esac
}

# ---------------------------------------------------------------------------
# Subscriber loop
# ---------------------------------------------------------------------------
echo "ha-commands: subscribing on ${HA_MQTT_HOST}:${HA_MQTT_PORT} for ${HA_CAMERA_ID}"
echo "ha-commands: topics: cameras/${HA_CAMERA_ID}/+/set"

# Use a named FIFO so we can track the mosquitto_sub PID and kill it explicitly
# on exit. Without this, mosquitto_sub becomes an orphan when the pipe closes:
# ha-daemon restarts ha-commands, launching a second mosquitto_sub with the
# same client_id — the two instances then fight each other endlessly, producing
# the "already connected, closing old connection" flood in the broker log.
MSUB_FIFO="/tmp/ha_msub_${HA_CAMERA_ID}.fifo"
rm -f "$MSUB_FIFO"
mkfifo "$MSUB_FIFO" || { echo "ha-commands: cannot create fifo" >&2; exit 1; }

# In BusyBox ash, 'sh -c "simple_command"' execs the command directly, so
# MSUB_PID is the mosquitto_sub PID itself.
sh -c "$MSUB" > "$MSUB_FIFO" 2>&1 &
MSUB_PID=$!

cleanup_sub() {
	kill "$MSUB_PID" 2>/dev/null
	wait "$MSUB_PID" 2>/dev/null
	rm -f "$MSUB_FIFO"
}
trap cleanup_sub EXIT INT TERM

while IFS= read -r line; do
	# mosquitto_sub error lines start with "Error" or contain "Connection"
	case "$line" in
		Error*|*"Connection refused"*|*"authentication"*|*"not authorised"*)
			echo "ha-commands: broker error: $line" >&2
			;;
		*)
			mqtt_topic="${line%% *}"
			mqtt_payload="${line#* }"
			[ -z "$mqtt_topic" ] && continue
			echo "ha-commands: ${mqtt_topic} = ${mqtt_payload}"
			dispatch "$mqtt_topic" "$mqtt_payload"
			;;
	esac
done < "$MSUB_FIFO"

echo "ha-commands: mosquitto_sub exited" >&2
