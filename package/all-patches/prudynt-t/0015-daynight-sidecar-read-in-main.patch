+  DIAG("B: lock acquired");
 
   // Install crash signal handlers to clean up lock file and collect diagnostics
   // on abnormal termination
+  // DIAGNOSTIC: run the crash handler on a dedicated alternate stack
+  // (SA_ONSTACK). Without this the handler cannot execute when the fault is a
+  // stack overflow (the kernel can't push the signal frame onto an exhausted
+  // stack), so no /tmp/prudynt_crash.log is produced and the crash is invisible.
+  // With an alt stack the handler runs and writes the register/backtrace report
+  // regardless of fault type.
+  static char crash_alt_stack[32768];
+  stack_t crash_ss;
+  crash_ss.ss_sp = crash_alt_stack;
+  crash_ss.ss_size = sizeof(crash_alt_stack);
+  crash_ss.ss_flags = 0;
+  sigaltstack(&crash_ss, nullptr);
+  DIAG("B2: sigaltstack set");
