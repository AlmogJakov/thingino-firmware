 using namespace std::chrono;
 
+// DIAG: unbuffered startup marker -- raw write(2) so output survives a crash
+// (the Logger buffers, hiding the last lines before a segfault). Throwaway.
+#define DIAG(s)                                                                 \
+  do {                                                                          \
+    static const char _dm[] = "DIAG: " s "\n";                                  \
+    ssize_t _dw = write(2, _dm, sizeof(_dm) - 1);                               \
+    (void)_dw;                                                                  \
+  } while (0)
