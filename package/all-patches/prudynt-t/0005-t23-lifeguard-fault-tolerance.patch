diff --git a/src/VideoWorker.cpp b/src/VideoWorker.cpp
index 59d5fb3..bc08e4c 100644
--- a/src/VideoWorker.cpp
+++ b/src/VideoWorker.cpp
@@ -39,6 +39,28 @@ void VideoWorker::run() {
   uint32_t bps = 0;
   uint32_t fps = 0;
   uint32_t error_count = 0; // Keep track of polling errors
+  // Bounded stall recovery: if the encoder yields no frame for kStallRestartMs
+  // (GetStream keeps failing or PollingStream keeps timing out), request the
+  // proven pipeline rebuild instead of spinning forever on `continue`. Stock
+  // prudynt incremented error_count but never acted on it -> a wedged encoder
+  // meant a silent, permanent black live view on a 24/7 life-guard camera.
+  // Reset on every delivered frame and on subscriber (re)connect so an idle
+  // stream that simply has no viewers never trips it.
+  constexpr uint64_t kStallRestartMs = 8000;
+  uint64_t last_progress_ms = monotonic_ms();
+  auto request_restart_if_stalled = [&]() {
+    uint64_t idle = monotonic_ms() - last_progress_ms;
+    if (idle <= kStallRestartMs)
+      return;
+    LOG_ERROR("VideoWorker ch" << encChn << ": no encoded frame for " << idle
+                               << "ms; requesting pipeline restart");
+    {
+      std::lock_guard<std::mutex> lk(mutex_main);
+      global_restart_video = true;
+    }
+    global_cv_worker_restart.notify_all();
+    last_progress_ms = monotonic_ms(); // don't re-trigger before the rebuild
+  };
   unsigned long long ms = 0;
   bool run_for_jpeg = false;
   auto video_state = global_video[encChn];
@@ -296,6 +318,7 @@ void VideoWorker::run() {
       ts_last_rtp_us = 0;
       ts_current_frame_us = 0;
       ts_have_current_frame = false;
+      last_progress_ms = monotonic_ms(); // fresh start; don't count idle as stall
     }
     had_video_clients = video_clients_active;
 
@@ -354,6 +377,7 @@ void VideoWorker::run() {
         if (IMP_Encoder_GetStream(encChn, &stream, GET_STREAM_BLOCKING) != 0) {
           LOG_ERROR("IMP_Encoder_GetStream(" << encChn << ") failed");
           error_count++;
+          request_restart_if_stalled();
           continue;
         }
 
@@ -362,6 +386,10 @@ void VideoWorker::run() {
           continue;
         }
 
+        // A real encoded frame arrived — the encoder is making progress.
+        error_count = 0;
+        last_progress_ms = monotonic_ms();
+
         int64_t nominal_frame_step_us = 33333;
         if (video_state && video_state->stream &&
             video_state->stream->fps > 0) {
@@ -820,6 +848,7 @@ void VideoWorker::run() {
         }
       } else {
         error_count++;
+        request_restart_if_stalled();
         LOG_DDEBUG("IMP_Encoder_PollingStream("
                    << encChn << ", " << cfg->general.imp_polling_timeout_ms
                    << ") timeout !");
diff --git a/src/prudyntctl.cpp b/src/prudyntctl.cpp
index 2760192..d4aaadb 100644
--- a/src/prudyntctl.cpp
+++ b/src/prudyntctl.cpp
@@ -7,6 +7,7 @@
 #include <vector>
 
 #include <sys/socket.h>
+#include <sys/time.h>
 #include <sys/un.h>
 
 static const char *SOCK_PATH = "/run/prudynt/prudynt.sock";
@@ -15,6 +16,16 @@ static int connect_sock() {
   int fd = socket(AF_UNIX, SOCK_STREAM, 0);
   if (fd < 0)
     return -1;
+  // Bound every blocking read/write so a wedged prudynt IPC server can never
+  // hang the caller indefinitely. Critical for a life-guard camera: the single
+  // DayNightWorker thread shells out to /sbin/daynight -> color -> prudyntctl,
+  // so an unbounded read here would freeze ALL future day/night switches. 5s is
+  // generous for a local AF_UNIX round-trip.
+  struct timeval tv;
+  tv.tv_sec = 5;
+  tv.tv_usec = 0;
+  setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+  setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
   sockaddr_un sa{};
   sa.sun_family = AF_UNIX;
   strncpy(sa.sun_path, SOCK_PATH, sizeof(sa.sun_path) - 1);
