+
+// Apply STRUCTURAL OSD changes (item enable/disable) live, with NO encoder/VPU/
+// group teardown: only toggle visibility of already-registered regions via
+// IMP_OSD_ShowRgn inside the bound group. Runs ONLY on the OSD worker thread
+// (thread_entry), triggered by the ThreadOSD action bit. Font/stroke size and
+// whole-OSD enable-from-off still require a restart (out of scope). (0017)
+void OSD::applyStructural() {
+  if (!is_started)
+    return;
+  if (time_region_created)
+    IMP_OSD_ShowRgn(osdTime.imp_rgn, osdGrp, osd.time_enabled ? 1 : 0);
+  if (user_region_created)
+    IMP_OSD_ShowRgn(osdUser.imp_rgn, osdGrp, osd.usertext_enabled ? 1 : 0);
+  if (uptime_region_created)
+    IMP_OSD_ShowRgn(osdUptm.imp_rgn, osdGrp, osd.uptime_enabled ? 1 : 0);
+  if (logo_region_created)
+    IMP_OSD_ShowRgn(osdLogo.imp_rgn, osdGrp, osd.logo_enabled ? 1 : 0);
 }
 
