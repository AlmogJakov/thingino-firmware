@@ -350,7 +350,22 @@ void AudioWorker::publishTapFrame(const IMPAudioFrame &frame) {
                static_cast<size_t>(frame.len));
 }
 
-void AudioWorker::process_frame(IMPAudioFrame &frame) {
+void AudioWorker::process_frame(IMPAudioFrame &frameRef) {
+  // Physical-privacy software mute: operate on a LOCAL copy so the caller's frame
+  // (released by IMP_AI_ReleaseFrame in run()) stays byte-identical to what GetFrame
+  // returned -- IMP_AI_ReleaseFrame recovers the DMA block's allocator header from
+  // *(virAddr-20), so redirecting the released frame's virAddr would corrupt the free.
+  // The copy is pointed at a zeroed scratch buffer when muted, so the encoder, FIFO tap,
+  // MP4 recorder, and RTSP/go2rtc feed all get true silence; the IMP_AI DMA slot (data
+  // AND descriptor) is never touched. Runtime atomic, no flash.
+  IMPAudioFrame frame = frameRef;
+  if (global_audio[encChn]->muted.load(std::memory_order_relaxed) &&
+      frame.virAddr != nullptr && frame.len > 0) {
+    if (mutedScratch.size() < static_cast<size_t>(frame.len))
+      mutedScratch.resize(static_cast<size_t>(frame.len));
+    memset(mutedScratch.data(), 0, static_cast<size_t>(frame.len));
+    frame.virAddr = reinterpret_cast<uint32_t *>(mutedScratch.data());
+  }
   if (global_audio[encChn]->imp_audio->outChnCnt == 2 &&
       frame.soundmode == AUDIO_SOUND_MODE_MONO) {
     size_t sample_size = frame.bitwidth / 8;
