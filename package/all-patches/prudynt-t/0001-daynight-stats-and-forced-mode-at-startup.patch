+  // hold) diff the encoder-/pipeline-defining fields before vs after and report
+  // which subsystems changed, so the caller (ConfigWatcher) can trigger a
+  // precise, minimal pipeline restart. Never touches mutex_main.
+  ConfigChange reload_and_diff();
   static CFG *createNew();
   bool readConfig();
   bool updateConfig();
