+  // delegate here, so configMutex is never acquired recursively.
+  void load_locked();
+  // Compact fingerprint of all encoder-/pipeline-defining fields, built from the
+  // current C++ members. MUST be called with configMutex held. Diffed before vs
+  // after a reload so a change maps to the minimal restart flag set.
+  struct EncoderFingerprint {
+    std::string video; // per-stream encoder/framesource geometry+RC + sensor dims + OSD-enable
+    std::string rtsp;  // fields that force an RTP-sink rebuild (format + resolution + spk)
+    std::string audio; // audio capture/playback reconfig fields
+  };
