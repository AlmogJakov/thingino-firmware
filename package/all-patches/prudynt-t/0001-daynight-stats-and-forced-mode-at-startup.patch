+
+void ConfigWatcher::trigger_reload() {
+  // Reload + diff under configMutex (inside reload_and_diff), then trigger ONLY
+  // the restart(s) for the subsystem whose encoder-defining config changed.
+  // Benign edits (image ISP tuning, OSD content, daynight incl. force_mode,
+  // motion params, rtsp network knobs) set no flag -> zero stream disruption.
+  ConfigChange chg = cfg->reload_and_diff();
+
+  if (!chg.any()) {
+    // File was reparsed but no encoder-/pipeline-defining field changed (live
+    // ISP tuning, OSD content, day/night, motion params, rtsp network knobs).
+    LOG_DEBUG("Config file reloaded from " << cfg->filePath
+              << " (benign change; no worker restart).");
+    return;
+  }
+
+  {
+    // Set flags under mutex_main — the lock the main loop holds while waiting on
+    // the cv and while re-arming the flags — so we never clobber an in-flight
+    // reset. Flags are OR-ed/sticky; the main loop is the sole resetter.
+    // configMutex is already released (the two locks are never nested).
+    std::lock_guard<std::mutex> lock(mutex_main);
+    if (chg.video)
+      global_restart_video = true;
+    if (chg.rtsp)
+      global_restart_rtsp = true;
+    if (chg.audio)
+      global_restart_audio = true;
+  }
+  global_cv_worker_restart.notify_one();
+
+  LOG_INFO("Config file reloaded from " << cfg->filePath
+           << " -> pipeline restart (video=" << chg.video << " rtsp="
+           << chg.rtsp << " audio=" << chg.audio << ")");
+}
