+  // the one setting that drives color/mono — no separate persisted running_mode.
+  if (cfg->daynight.force_mode_cfg && cfg->daynight.force_mode_cfg[0]) {
+    if (strcmp(cfg->daynight.force_mode_cfg, "night") == 0)
+      cfg->image.running_mode = static_cast<int>(hal::isp::RunningMode::Night);
+    else if (strcmp(cfg->daynight.force_mode_cfg, "day") == 0)
+      cfg->image.running_mode = static_cast<int>(hal::isp::RunningMode::Day);
+  }
   ret = hal::isp::set_running_mode(
       static_cast<hal::isp::RunningMode>(cfg->image.running_mode));
   LOG_DEBUG_OR_ERROR(ret, "hal::isp::set_running_mode("
@@ -596,9 +610,14 @@ int IMPSystem::init() {
                                        << fps_num << ", " << fps_den << ")");
 #endif
 
-  // Set the ISP to DAY on launch
-  ret = hal::isp::set_running_mode(hal::isp::RunningMode::Day);
-  LOG_DEBUG_OR_ERROR_AND_EXIT(ret, "hal::isp::set_running_mode(Day)");
+  // NB: the boot running mode is set ONCE, early in init (the force_mode-derived
+  // set_running_mode right after the hflip/vflip block) — that is the call that
+  // actually sticks on this sensor. The stock code re-asserted
+  // set_running_mode(Day) HERE at end of init; we deliberately do NOT re-assert,
+  // because (a) a late set is a no-op on this sensor anyway and (b) re-issuing a
+  // Night sensor-mode switch this close to the encoder pipeline build
+  // intermittently stalls the cold-boot stream (~2-5s in). The early set is
+  // authoritative; nothing more is needed at launch.
 #endif // #if !defined(NO_TUNINGS)
 
   return ret;
