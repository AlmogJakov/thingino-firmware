+namespace {
+// Encoder/framesource-defining fields of one video stream (+ OSD enable, which
+// gates the OSD thread's lifecycle in the video-restart block). Cosmetic OSD
+// content/position and live stats are intentionally excluded.
+void fp_video_stream(std::ostringstream &os, const _stream &s) {
+  const char *mode = s.mode ? s.mode : "";
+  const char *fmt = s.format ? s.format : "";
+  os << '|' << s.enabled << ',' << s.video_enabled << ',' << fmt << ',' << mode
+     << ',' << s.width << ',' << s.height << ',' << s.fps << ',' << s.bitrate
+     << ',' << s.gop << ',' << s.max_gop << ',' << s.profile << ',' << s.buffers
+     << ',' << s.rotation << ',' << s.scale_enabled << ',' << s.scale_width
+     << ',' << s.scale_height << ',' << s.qp_init << ',' << s.qp_min << ','
+     << s.qp_max << ',' << s.ip_delta << ',' << s.pb_delta << ','
+     << s.max_bitrate << ',' << s.osd.enabled;
+}
+// JPEG-stream channel-creation fields.
+void fp_jpeg_stream(std::ostringstream &os, const _stream &s) {
+  os << '|' << s.enabled << ',' << s.width << ',' << s.height << ','
+     << s.jpeg_quality << ',' << s.jpeg_channel;
+}
+// RTP-sink-defining fields (codec from format, and resolution) of one stream.
+void fp_rtsp_stream(std::ostringstream &os, const _stream &s) {
+  const char *fmt = s.format ? s.format : "";
+  os << '|' << fmt << ',' << s.width << ',' << s.height << ',' << s.enabled
+     << ',' << s.video_enabled;
+}
+} // namespace
+
+CFG::EncoderFingerprint CFG::fingerprint_locked() const {
+  // NOTE: caller MUST already hold configMutex. Reads only C++ members (never
+  // the raw jsonConfig pointer), so it adds no new unsynchronised jsonConfig
+  // access. String CONTENT comparison (not pointer identity), so a same-value
+  // reparse yields an equal fingerprint and no spurious restart.
+  EncoderFingerprint fp;
+  {
+    std::ostringstream os;
+    // sensor dims/fps feed every framesource + all encoder geometry
+    os << "s:" << sensor.fps << ',' << sensor.width << ',' << sensor.height;
+    fp_video_stream(os, stream0);
+    fp_video_stream(os, stream1);
+    fp_jpeg_stream(os, stream2);
+    fp_jpeg_stream(os, stream3);
+    fp.video = os.str();
+  }
+  {
+    std::ostringstream os;
+    os << sensor.width << ',' << sensor.height; // resolution also hits RTP sink
+    fp_rtsp_stream(os, stream0);
+    fp_rtsp_stream(os, stream1);
+#if defined(LIB_AUDIO_PROCESSING)
+    os << "|spk:" << audio.output_enabled; // spk toggle rebuilds RTSP backchannel
+#endif
+    fp.rtsp = os.str();
+  }
+  {
+    std::ostringstream os;
+    const char *infmt = audio.input_format ? audio.input_format : "";
+    os << audio.input_enabled << ',' << infmt << ',' << audio.input_bitrate
+       << ',' << audio.input_sample_rate
+#if defined(LIB_AUDIO_PROCESSING)
+       << ',' << audio.input_noise_suppression << ',' << audio.input_agc_enabled
+       << ',' << audio.input_agc_target_level_dbfs << ','
+       << audio.input_agc_compression_gain_db << ',' << audio.force_stereo << ','
+       << audio.output_enabled << ',' << audio.output_sample_rate
+#endif
+        ;
+    fp.audio = os.str();
+  }
+  return fp;
+}
+
+ConfigChange CFG::reload_and_diff() {
+  // Snapshot encoder-defining state, reload, re-snapshot, diff — all under a
+  // single configMutex hold so detection is atomic with the reparse. No second
+  // lock acquisition another writer could interleave; configMutex is fully
+  // released before the caller takes mutex_main (the two are never nested).
+  std::lock_guard<std::mutex> lock(configMutex);
+
+  EncoderFingerprint before = fingerprint_locked();
+  bool motion_before = motion.enabled;
+
+  load_locked();
+
+  EncoderFingerprint after = fingerprint_locked();
+  bool motion_after = motion.enabled;
+
+  ConfigChange chg;
+  if (before.video != after.video || motion_before != motion_after)
+    chg.video = true;
+  if (before.rtsp != after.rtsp)
+    chg.rtsp = true;
+  if (before.audio != after.audio)
+    chg.audio = true;
+  return chg;
+}
