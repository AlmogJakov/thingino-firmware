+         const std::string s(v);
+         return s == "day" || s == "night";
+       }},
       {"daynight.schedule.start_at", daynight.schedule.start_at, "",
        validateCharDummy},
       {"daynight.schedule.stop_at", daynight.schedule.stop_at, "",
diff --git a/src/Config.hpp b/src/Config.hpp
index 581c7b8..f2600a9 100644
--- a/src/Config.hpp
+++ b/src/Config.hpp
@@ -156,6 +156,14 @@ struct _daynight {
   // Manual mode override (set by user via JSON API)
   std::atomic<const char *> force_mode{nullptr};
 
+  // Persisted startup override ("", "day" or "night") so a forced mode survives
+  // restarts/reboots. The worker RECORDS it at startup (sets current/live_mode,
+  // suppresses auto-inference) but does not apply it on the live pipeline; the
+  // ISP running mode is set from it in IMPSystem::init() before the pipeline
+  // exists, and the IR-CUT/IR-LED optics by the boot IR-CUT init. The force_mode
+  // atomic above remains the live runtime path.
+  const char *force_mode_cfg{nullptr};
+
   // Live telemetry populated by the worker - RAW ISP sensor data
   std::atomic<int> live_brightness_percent{-1};
   std::atomic<int> live_ev{-1};
diff --git a/src/DayNightWorker.cpp b/src/DayNightWorker.cpp
index 793b812..d50eb22 100644
--- a/src/DayNightWorker.cpp
+++ b/src/DayNightWorker.cpp
@@ -649,6 +649,39 @@ void *thread_entry(void *arg) {
   int anti_flap_cooldown = 0;
   const int anti_flap_iterations = 30; // ~30 seconds minimum between switches
 
+  // Persisted startup force_mode (daynight.force_mode): RECORD it only — set
+  // current/live_mode and suppress auto-inference (initial_mode_applied), but do
+  // NOT apply_mode() on the live pipeline. The forced mode is realised entirely
+  // outside this loop, BEFORE any frame is shown, so there is never a day->night
+  // flip and never an apply() on a settling cold-boot encoder:
+  //   * ISP running mode (color vs mono) is set in IMPSystem::init() from
+  //     force_mode_cfg, before the encoder pipeline is built.
+  //   * IR-CUT filter + IR LED GPIO are set by the boot IR-CUT init (S56ircut),
+  //     which finishes its calibration in the persisted mode.
+  // History: apply_mode() here (v1) tore the stream down on cold boot; a
+  // deferred apply (v3) reintroduced a visible boot-time flip. Record-only
+  // avoids both. The force_mode atomic remains the live runtime path.
+  if (cfg->daynight.force_mode_cfg && *cfg->daynight.force_mode_cfg) {
+    if (std::strcmp(cfg->daynight.force_mode_cfg, "night") == 0) {
+      current = DayNightAlgo::Mode::Night;
+      simple_state.is_night = true;
+      cfg->daynight.live_mode.store("night", std::memory_order_relaxed);
+      initial_mode_applied = true;
+    } else if (std::strcmp(cfg->daynight.force_mode_cfg, "day") == 0) {
+      current = DayNightAlgo::Mode::Day;
+      simple_state.is_night = false;
+      cfg->daynight.live_mode.store("day", std::memory_order_relaxed);
+      initial_mode_applied = true;
+    }
+    // Observable marker: proves this record block is in the running binary
+    // (strings) and fired at boot with which value (logread). If this line never
+    // appears at boot but daynight.force_mode is set, force_mode_cfg failed to load.
+    LOG_INFO("DayNight: recorded persisted startup force_mode="
+             << cfg->daynight.force_mode_cfg << " (record-only, no apply)");
+  } else {
+    LOG_INFO("DayNight: no persisted startup force_mode (force_mode_cfg empty)");
+  }
+
   while (!global_shutdown_requested.load(std::memory_order_relaxed)) {
     refresh_daynight_log_level();
 
@@ -724,7 +757,7 @@ void *thread_entry(void *arg) {
     // Apply initial mode if not set - infer from current sensor readings
     // IMPORTANT: This happens regardless of schedule to ensure camera starts in
     // correct mode
-    if (!initial_mode_applied) {
+    if (!initial_mode_applied && cfg->daynight.enabled) {
       DayNightAlgo::Mode initial = DayNightAlgo::Mode::Unknown;
 
       // Infer initial mode from sensor readings to avoid black screen on boot
@@ -843,7 +876,9 @@ void *thread_entry(void *arg) {
     }
 
     const char *mode_str =
-        (current == DayNightAlgo::Mode::Day) ? "day" : "night";
+        (current == DayNightAlgo::Mode::Day)     ? "day"
+        : (current == DayNightAlgo::Mode::Night) ? "night"
+                                                 : "unknown";
     cfg->daynight.live_mode.store(mode_str, std::memory_order_relaxed);
     export_brightness_value(bright_pct, mode_str);
 
diff --git a/src/IMPSystem.cpp b/src/IMPSystem.cpp
index 769ba91..19fc955 100644
--- a/src/IMPSystem.cpp
+++ b/src/IMPSystem.cpp
@@ -430,6 +430,20 @@ int IMPSystem::init() {
   ret = hal::isp::set_vflip(cfg->image.vflip);
   LOG_DEBUG_OR_ERROR(ret, "hal::isp::set_vflip(" << cfg->image.vflip << ")");
 
+  // Single source of truth for the boot color/mono mode: derive
+  // image.running_mode from the persisted forced day/night mode
+  // (daynight.force_mode), then apply it HERE — early in init — where it
+  // reliably takes effect on this sensor. A late set_running_mode (end of init)
+  // does NOT stick on sc2336p, which is why a forced mode must land at this early
+  // point. Auto / unset (empty force_mode) keeps the configured image.running_mode
+  // and lets the daynight worker decide at runtime. This makes daynight.force_mode
+  // the one setting that drives color/mono — no separate persisted running_mode.
+  if (cfg->daynight.force_mode_cfg && cfg->daynight.force_mode_cfg[0]) {
+    if (strcmp(cfg->daynight.force_mode_cfg, "night") == 0)
+      cfg->image.running_mode = static_cast<int>(hal::isp::RunningMode::Night);
+    else if (strcmp(cfg->daynight.force_mode_cfg, "day") == 0)
+      cfg->image.running_mode = static_cast<int>(hal::isp::RunningMode::Day);
+  }
   ret = hal::isp::set_running_mode(
       static_cast<hal::isp::RunningMode>(cfg->image.running_mode));
   LOG_DEBUG_OR_ERROR(ret, "hal::isp::set_running_mode("
@@ -596,9 +610,18 @@ int IMPSystem::init() {
                                        << fps_num << ", " << fps_den << ")");
 #endif
 
-  // Set the ISP to DAY on launch
-  ret = hal::isp::set_running_mode(hal::isp::RunningMode::Day);
-  LOG_DEBUG_OR_ERROR_AND_EXIT(ret, "hal::isp::set_running_mode(Day)");
+  // Re-assert the running mode at end of init. This replaces the old hardcoded
+  // set_running_mode(Day), which used to clobber a forced-night boot. The
+  // authoritative apply is the EARLY one above (the only one that sticks on this
+  // sensor); this end-of-init call is a harmless re-assert of the same value.
+  // Clamp to Day/Night (image.running_mode validates 0/1/2). Non-fatal.
+  {
+    hal::isp::RunningMode boot_mode = (cfg->image.running_mode == 1)
+                                          ? hal::isp::RunningMode::Night
+                                          : hal::isp::RunningMode::Day;
+    int rm_ret = hal::isp::set_running_mode(boot_mode);
+    LOG_DEBUG_OR_ERROR(rm_ret, "hal::isp::set_running_mode(launch)");
+  }
 #endif // #if !defined(NO_TUNINGS)
 
   return ret;
