+// Result of a config-file reload diff: which worker subsystems must restart
+// because an encoder-/pipeline-defining field actually changed. any()==false
+// means the edit was benign (image ISP tuning, OSD content, daynight incl.
+// force_mode, motion params, rtsp network knobs) and the live stream is NOT
+// disturbed.
+struct ConfigChange {
+  bool video = false; // encoder/framesource geometry+RC, JPEG, sensor dims, OSD enable
+  bool rtsp = false;  // RTP-sink-defining: video format or resolution, or spk toggle
+  bool audio = false; // audio capture/playback reconfig
+  bool any() const { return video || rtsp || audio; }
+};
