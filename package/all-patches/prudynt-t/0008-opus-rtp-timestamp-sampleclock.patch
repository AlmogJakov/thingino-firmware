+      // OPUS/WebRTC needs a perfectly steady RTP clock: stamp from a monotonic SAMPLE
+      // counter (advance by each frame's exact duration); re-anchor only on a large
+      // forward wallclock gap. EVERY non-OPUS codec (AAC, PCM, G711, ...) falls through to
+      // the UNCHANGED stock path in the else below, so this patch cannot affect them. All
+      // math is in the capture clock; live555 converts to the 48k OPUS RTP clock.
+      if (imp_audio && imp_audio->format == IMPAudioFormat::OPUS) {
+        static constexpr int64_t kAudioReanchorFwdUs = 250000;
+        int orate = sampleRate > 0 ? sampleRate : 16000;
+        int64_t frameSamples = nal.samples > 0
+                                   ? static_cast<int64_t>(nal.samples)
+                                   : static_cast<int64_t>(orate) * 40 / 1000;
+        if (frameSamples < 1) {
+          frameSamples = 1;
+        }
+        int64_t stepUs = frameSamples * 1000000LL / orate;
+        if (stepUs < 1) {
+          stepUs = 1;
+        }
+        gettimeofday(&fPresentationTime, NULL);
+        int64_t nowUs = tv_to_us(fPresentationTime);
+        if (audioAnchorUs < 0 || orate != audioAnchorRate) {
+          audioAnchorUs = nowUs;
+          audioSamplesSinceAnchor = 0;
+          audioAnchorRate = orate;
+        }
+        int64_t pts_us =
+            audioAnchorUs + audioSamplesSinceAnchor * 1000000LL / orate;
+        int64_t drift_us = nowUs - pts_us;
+        if (drift_us > kAudioReanchorFwdUs) {
+          int64_t candidate = nowUs;
+          if (audioLastPtsUs >= 0 && candidate <= audioLastPtsUs) {
+            candidate = audioLastPtsUs + stepUs;
+          }
+          audioAnchorUs = candidate;
+          audioSamplesSinceAnchor = 0;
+          audioAnchorRate = orate;
+          pts_us = candidate;
+          static int64_t last_reanchor_log_us = 0;
+          if (nowUs - last_reanchor_log_us >= 5000000LL) {
+            last_reanchor_log_us = nowUs;
+            LOG_INFO("audio RTP re-anchor (OPUS): fwd drift "
