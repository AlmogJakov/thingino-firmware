+#if defined(PLATFORM_T23)
+// ---------------------------------------------------------------------------
+// Live (no-teardown) encoder reconfiguration — T23 / PLATFORM_OLD_SDK path.
+//
+// Called ONLY from the VideoWorker thread (the owner of IMP_Encoder_GetStream),
+// at the top of its loop between frames, so these SDK calls are never
+// concurrent with GetStream and require no locking. They read the current
+// rate-control attributes back, mutate only the requested field for whatever
+// rcMode is actually active, write them back, and request a keyframe so the
+// change is visible immediately. No channel is torn down, so the T23 VPU
+// teardown/rebuild hazard is avoided entirely. JPEG channels have no rate
+// controller and are skipped.
+//
+// Struct paths verified against include/T23/1.3.0/zh/imp/imp_encoder.h and
+// this file's own initProfile(): CBR bitrate = attrH264Cbr.outBitRate,
+// VBR/Smart = attrH264{Vbr,Smart}.maxBitRate, QP = .maxQp/.minQp; GOP cfg
+// field = gopsize; on T23 H264 RC is forced to CBR (see initProfile).
+// ---------------------------------------------------------------------------
+int IMPEncoder::setLiveBitrate(int kbps) {
+  if (is_jpeg_stream || kbps <= 0) {
+    return -1;
+  }
+
+  IMPEncoderAttrRcMode rc{};
+  int ret = IMP_Encoder_GetChnAttrRcMode(encChn, &rc);
+  if (ret != 0) {
+    LOG_ERROR("setLiveBitrate: GetChnAttrRcMode(" << encChn << ") ret=" << ret);
+    return ret;
+  }
+  switch (rc.rcMode) {
+  case ENC_RC_MODE_CBR:
+    rc.attrH264Cbr.outBitRate = static_cast<uint32_t>(kbps);
+    break;
+  case ENC_RC_MODE_VBR:
+    rc.attrH264Vbr.maxBitRate = static_cast<uint32_t>(kbps);
+    break;
+  case ENC_RC_MODE_SMART:
+    rc.attrH264Smart.maxBitRate = static_cast<uint32_t>(kbps);
+    break;
+  default: // FIXQP / unsupported: no bitrate field
+    LOG_DEBUG("setLiveBitrate: rcMode " << static_cast<int>(rc.rcMode)
+                                        << " has no bitrate field, skipping");
+    return 0;
+  }
+  ret = IMP_Encoder_SetChnAttrRcMode(encChn, &rc);
+  if (ret != 0) {
+    LOG_ERROR("setLiveBitrate: SetChnAttrRcMode(" << encChn << ") ret=" << ret);
+    return ret;
+  }
+  IMP_Encoder_RequestIDR(encChn);
+  LOG_INFO("setLiveBitrate(" << encChn << "): " << kbps << " kbps (rcMode "
+                             << static_cast<int>(rc.rcMode) << ")");
+  return 0;
+}
+
+int IMPEncoder::setLiveFps(int frmRateNum, int frmRateDen) {
+  if (is_jpeg_stream || frmRateNum <= 0 || frmRateDen <= 0) {
+    return -1;
+  }
+
+  IMPEncoderFrmRate frmRate{};
+  frmRate.frmRateNum = static_cast<uint32_t>(frmRateNum);
+  frmRate.frmRateDen = static_cast<uint32_t>(frmRateDen);
+  int ret = IMP_Encoder_SetChnFrmRate(encChn, &frmRate);
+  if (ret != 0) {
+    LOG_ERROR("setLiveFps: SetChnFrmRate(" << encChn << ") ret=" << ret);
+    return ret;
+  }
+  LOG_INFO("setLiveFps(" << encChn << "): " << frmRateNum << "/" << frmRateDen
+                         << " (effective next GOP)");
+  return 0;
+}
+
+int IMPEncoder::setLiveGop(int gop) {
+  if (is_jpeg_stream || gop <= 0) {
+    return -1;
+  }
+
+  IMPEncoderGOPSizeCfg gopCfg{};
+  gopCfg.gopsize = gop;
+  int ret = IMP_Encoder_SetGOPSize(encChn, &gopCfg);
+  if (ret != 0) {
+    LOG_ERROR("setLiveGop: SetGOPSize(" << encChn << ") ret=" << ret);
+    return ret;
+  }
+  LOG_INFO("setLiveGop(" << encChn << "): " << gop);
+  return 0;
+}
+
+int IMPEncoder::setLiveQp(int qpMin, int qpMax) {
+  if (is_jpeg_stream) {
+    return -1;
+  }
+  if (qpMin < 0 && qpMax < 0) {
+    return 0; // nothing to change (-1 sentinel == leave as-is)
+  }
+
+  IMPEncoderAttrRcMode rc{};
+  int ret = IMP_Encoder_GetChnAttrRcMode(encChn, &rc);
+  if (ret != 0) {
+    LOG_ERROR("setLiveQp: GetChnAttrRcMode(" << encChn << ") ret=" << ret);
+    return ret;
+  }
+  switch (rc.rcMode) {
+  case ENC_RC_MODE_CBR:
+    if (qpMin >= 0)
+      rc.attrH264Cbr.minQp = static_cast<uint32_t>(qpMin);
+    if (qpMax >= 0)
+      rc.attrH264Cbr.maxQp = static_cast<uint32_t>(qpMax);
+    break;
+  case ENC_RC_MODE_VBR:
+    if (qpMin >= 0)
+      rc.attrH264Vbr.minQp = static_cast<uint32_t>(qpMin);
+    if (qpMax >= 0)
+      rc.attrH264Vbr.maxQp = static_cast<uint32_t>(qpMax);
+    break;
+  case ENC_RC_MODE_SMART:
+    if (qpMin >= 0)
+      rc.attrH264Smart.minQp = static_cast<uint32_t>(qpMin);
+    if (qpMax >= 0)
+      rc.attrH264Smart.maxQp = static_cast<uint32_t>(qpMax);
+    break;
+  default:
+    LOG_DEBUG("setLiveQp: rcMode " << static_cast<int>(rc.rcMode)
+                                   << " has no QP fields, skipping");
+    return 0;
+  }
+  ret = IMP_Encoder_SetChnAttrRcMode(encChn, &rc);
+  if (ret != 0) {
+    LOG_ERROR("setLiveQp: SetChnAttrRcMode(" << encChn << ") ret=" << ret);
+    return ret;
+  }
+  IMP_Encoder_RequestIDR(encChn);
+  LOG_INFO("setLiveQp(" << encChn << "): min=" << qpMin << " max=" << qpMax
+                        << " (rcMode " << static_cast<int>(rc.rcMode) << ")");
+  return 0;
+}
+#endif // PLATFORM_T23
