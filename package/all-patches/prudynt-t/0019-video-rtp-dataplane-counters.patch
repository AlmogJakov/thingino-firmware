diff --git a/src/IMPDeviceSource.cpp b/src/IMPDeviceSource.cpp
index b1a04cb..e3845ca 100644
--- a/src/IMPDeviceSource.cpp
+++ b/src/IMPDeviceSource.cpp
@@ -234,6 +234,14 @@ void IMPDeviceSource<FrameType, Stream>::deliverFrame() {
     memcpy(fTo, &nal.data[0], fFrameSize);
 
     if (fFrameSize > 0) {
+      if constexpr (std::is_same_v<FrameType, H264NALUnit>) {
+        // 0019: count this NAL at the last prudynt-owned step before live555
+        // hands it to the RTP sink -- ground truth for "video is leaving the
+        // process". Read by the data-plane watchdog via prudyntctl stats.
+        stream->rtp_pkts.fetch_add(1, std::memory_order_relaxed);
+        stream->rtp_bytes.fetch_add(static_cast<uint32_t>(fFrameSize),
+                                    std::memory_order_relaxed);
+      }
       FramedSource::afterGetting(this);
       return;
     }
diff --git a/src/JsonAPI.cpp b/src/JsonAPI.cpp
index eef6ed8..826d17a 100644
--- a/src/JsonAPI.cpp
+++ b/src/JsonAPI.cpp
@@ -147,6 +147,25 @@ void handle_stream_stats(int idx, std::string &out) {
   add_num(out, fps);
   add_key(out, s, "Bps");
   add_num(out, bps);
+  // 0019: RTP-egress counters (video streams only) for the data-plane watchdog.
+  // Masked to positive int (add_num is int); the watchdog uses the delta only.
+  if ((idx == 0 || idx == 1) && global_video[idx]) {
+    add_key(out, s, "rtp_pkts");
+    add_num(out, (int)(global_video[idx]->rtp_pkts.load(std::memory_order_relaxed) &
+                       0x7fffffffu));
+    add_key(out, s, "rtp_bytes");
+    add_num(out, (int)(global_video[idx]->rtp_bytes.load(std::memory_order_relaxed) &
+                       0x7fffffffu));
+    // subs = 1 when THIS channel has a live RTSP consumer (the IMPDeviceSource
+    // sets hasDataCallback on SETUP/PLAY, clears it on teardown). The watchdog
+    // gates the "rtp frozen -> stall" verdict on this so a channel kept warm by
+    // a NON-RTSP consumer (recording/prebuffer/jpeg) with no RTSP client is
+    // never mistaken for a wedge (which would otherwise reboot-loop).
+    add_key(out, s, "subs");
+    add_num(out,
+            global_video[idx]->hasDataCallback.load(std::memory_order_relaxed) ? 1
+                                                                               : 0);
+  }
   out += "}";
 }
 
