+  // delta-based (this 32-bit MIPS SoC avoids 64-bit atomics, see frame_seq).
+  std::atomic<uint32_t> rtp_pkts{0};
+  std::atomic<uint32_t> rtp_bytes{0};
   std::atomic<bool> mp4_waiting_for_idr;
   std::atomic<int64_t> mp4_required_idr_ts_us;
   std::atomic<int64_t> mp4_last_idr_ts_us;
