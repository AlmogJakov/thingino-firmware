+  // 0015 (direct-read): /etc/daynight.state is the single source of truth for the
+  // persisted auto/day/night mode. Overlay it HERE -- after the item loops and the
+  // 0013 quote-strip -- so the sidecar is the FINAL word on every CFG::load(), both at
+  // boot and on every ConfigWatcher reload (a one-shot main() overlay would be reverted
+  // by the next reload). 0015 itself allocates/frees NOTHING (force_mode_cfg is a STATIC
+  // literal here). force_mode_cfg is a config char-item the layer never frees BY DESIGN (the
+  // lock-free readers IMPSystem/DayNightWorker/JsonAPI hold no lock, so a free() could UAF);
+  // the heap strdup that handleConfigItem/0013 install for it is therefore orphaned here --
+  // the SAME pre-existing per-load char-item leak that happens with or without 0015 (no new
+  // rate, just one constant ~16B copy). Readers only ever observe a complete, valid pointer
+  // (atomic word write). POSIX open/read/close only -- one open/read/close, no iostream. mode=auto keeps
+  // auto (force_mode_cfg == "" means "no force"); a missing / unreadable / malformed
+  // sidecar falls back to FORCED DAY -- the chosen safe default for broken persistence,
+  // matching daynight-state's get + migrate. This code never throws, blocks, allocates,
+  // frees, or writes prudynt.json.
+  {
+    char sbuf[64];
+    ssize_t sn = -1;
+    int sfd = ::open("/etc/daynight.state", O_RDONLY);
+    if (sfd >= 0) {
+      sn = ::read(sfd, sbuf, sizeof(sbuf) - 1);
+      ::close(sfd);
+    }
+    sbuf[(sn > 0) ? (size_t)sn : 0] = '\0';
+    char smode[8];
+    size_t si = 0;
+    if (const char *sp = std::strstr(sbuf, "mode=")) {
+      sp += 5; // skip "mode="
+      while (*sp == '"' || *sp == ' ' || *sp == '\t' || *sp == '\r' || *sp == '\n')
+        ++sp;
+      while (si < sizeof(smode) - 1 && *sp >= 'a' && *sp <= 'z')
+        smode[si++] = *sp++;
+    }
+    smode[si] = '\0';
+    if (std::strcmp(smode, "night") == 0) {
+      daynight.enabled = false;
+      daynight.force_mode_cfg = "night";
+    } else if (std::strcmp(smode, "day") == 0) {
+      daynight.enabled = false;
+      daynight.force_mode_cfg = "day";
+    } else if (std::strcmp(smode, "auto") == 0) {
+      daynight.enabled = true;
+      daynight.force_mode_cfg = "";
+    } else { // missing / unreadable / malformed -> FORCED DAY (safe fallback)
+      daynight.enabled = false;
+      daynight.force_mode_cfg = "day";
+    }
+  }
