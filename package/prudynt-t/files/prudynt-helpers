#!/bin/sh

CURL="curl --show-error --fail --connect-timeout 10 --max-time 30 --retry 3 --location --max-redirs 5"
EMAIL_FORMAT='^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$'
PORTAL_MODE_FLAG="/run/portal_mode"

echo_command() {
	echo -c 101 -e "$1" >&2
}

echo_error() {
	echo -c 160 -e "$1" >&2
}

echo_info() {
	echo -c 240 -e "- $1" >&2
}

echo_title() {
	echo -c 15 -e "$1 ..." >&2
}

echo_warning() {
	echo -c 142 -e "$1" >&2
}

ensure_dir() {
	if [ -d "$1" ]; then
		echo_info "Directory $1 exists"
		return 0
	fi

	if ! mkdir -p "$1"; then
		echo_error "Cannot create directory $1"
	fi

	if [ ! -w "$1" ]; then
		echo_error "Cannot write to $1"
	fi
}

singleton() {
	if [ -z "$1" ]; then
		echo_error "Program name is missing"
		exit 1
	fi

	appname=$(basename "$1")
	# Mutual exclusion via an advisory flock on a tmpfs lock file, replacing the
	# previous `pidof` check. `pidof` reads /proc/<pid>/cmdline of EVERY process;
	# if any task is stuck in uninterruptible (D) sleep holding its mmap_sem, that
	# read blocks, so pidof -- and every singleton-guarded script (daynight,
	# formatsd, ...) -- wedges behind an unrelated stuck task. `flock` touches no
	# /proc and is cheaper than the old /proc-wide scan. `-n` = non-blocking
	# (busybox lacks `-w`); the lock file lives on tmpfs -> no flash writes.
	#
	# LOCK LIFETIME: the lock is held via fd 9 and the kernel releases it the moment
	# the last open file description on fd 9 is closed -- which happens automatically
	# when the holder exits, INCLUDING SIGKILL/crash (no stale lock, no reclaim, no
	# trap). Every current caller is a short-lived script whose children are
	# synchronous (they exit before the script), so the lock always disappears
	# promptly on the caller's death. fd 9 IS inherited across fork/exec, so a future
	# caller that BACKGROUNDS a long-lived process MUST start it with `9>&-` (verified
	# here: an inherited fd 9 keeps the lock held past the parent's death; `9>&-`
	# frees it). ash cannot mark a shell fd close-on-exec, so this close-per-child is
	# the required convention for any long-lived spawned child.
	mkdir -p /run/lock 2>/dev/null
	exec 9>"/run/lock/singleton.$appname"
	if ! flock -n 9; then
		echo_error "$appname is already running. Exiting"
		exit 1
	fi
}
