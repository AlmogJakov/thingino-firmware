#!/bin/sh

. /usr/share/prudynt-helpers

# Serialize concurrent invocations using the stock pidof-based singleton.
# (An earlier version used `flock -w`, but busybox's flock lacks the `-w`
# timeout option on this build, so that command failed and the `|| exit`
# aborted the whole switch before any actuator ran — leaving the IR-cut/IR-LED
# frozen. The substantive Issue-A fix is the SYNCHRONOUS + read-back-verified
# actuation below (no `&`); the lock is secondary. If stronger serialization is
# ever needed, add a mkdir-based lock — NOT flock — after checking the device's
# busybox feature set.)
#
# This script also propagates a real EXIT STATUS: non-zero if a night-vision
# actuator (IR-cut or IR LED) could not be verified. prudynt's DayNightWorker
# uses it to avoid reporting a day/night mode the optics never physically
# reached (it holds the previous mode and retries). The colour switch is best
# effort here (`color` always exits 0 and the ISP mode is also set in-process),
# so it does not affect the status.
singleton $0

MODE_FILE="/run/prudynt/daynight_mode"
# Script-owned "last mode we actually applied + verified" marker. The dedup in
# switch_to_day/night keys on THIS, not MODE_FILE. MODE_FILE is written by
# prudynt and can lag/desync from the physical optics: a night->day that left
# MODE_FILE at "day" made switch_to_day dedup and silently no-op, stranding the
# camera in night. tmpfs -> cleared on reboot, so the first boot switch always
# actuates (no stale-skip of the boot IR-cut).
APPLIED_FILE="/run/daynight.applied"
PRUDYNT_CONFIG="/etc/prudynt.json"

command_present() {
	command -v "$1" >/dev/null 2>&1
}

get_value() {
	jct "$PRUDYNT_CONFIG" get "daynight.controls.$1" 2>/dev/null ||
		echo "true"
}

# Load control flags from prudynt config.
# NOTE: the visible white/flood LED is intentionally NOT day/night-managed
# (see the switch functions below) — it is controlled only via the manual
# light path. The white LED at boot is governed by the U-Boot gpio_default.
load_controls() {
	if command_present jct && [ -f "$PRUDYNT_CONFIG" ]; then
		day_night_color=$(get_value color)
		day_night_ircut=$(get_value ircut)
		day_night_ir850=$(get_value ir850)
		day_night_ir940=$(get_value ir940)
	else
		# Fallback defaults
		day_night_color="true"
		day_night_ircut="true"
		day_night_ir850="true"
		day_night_ir940="true"
	fi
}

# Drive an IR LED synchronously and verify the GPIO actually took, with a short
# bounded retry. "light <type> read" is a real GPIO read (gpio value), so this
# confirms the LED physically reached the requested state instead of firing the
# command and hoping (the old code backgrounded it with "&"). If the LED type
# is not defined on this board (e.g. ir940 here), "light ... read" prints
# nothing — treat that as "not present" and return success without spinning.
set_light_verified() {
	_type="$1"
	_want="$2" # on | off
	_n=0
	while [ "$_n" -lt 3 ]; do
		light "$_type" "$_want" 2>/dev/null
		_cur=$(light "$_type" read 2>/dev/null)
		[ -z "$_cur" ] && return 0 # pin not defined/readable -> nothing to do
		if { [ "$_want" = "on" ] && [ "$_cur" = "1" ]; } ||
			{ [ "$_want" = "off" ] && [ "$_cur" = "0" ]; }; then
			return 0
		fi
		_n=$((_n + 1))
		usleep 50000
	done
	echo_error "  $_type did not reach '$_want' (last read: '$_cur')"
	return 1
}

# Drive the IR-CUT filter and verify the command completed, with the same
# bounded retry. The mechanical latch has no GPIO level to read back, but
# "ircut read" returns the last commanded state (written only after the multi-
# step pulse completes), so a mismatch reliably catches a dropped/interrupted
# invocation. The IR-cut is the decisive night-vision actuator (it must be
# removed for the 850nm light to reach the sensor) and must not be
# fire-and-forget. want: on = day (filter set, read 1), off = night (read 0).
set_ircut_verified() {
	_want="$1"
	_n=0
	while [ "$_n" -lt 3 ]; do
		ircut "$_want"
		_cur=$(ircut read 2>/dev/null)
		if { [ "$_want" = "on" ] && [ "$_cur" = "1" ]; } ||
			{ [ "$_want" = "off" ] && [ "$_cur" = "0" ]; }; then
			return 0
		fi
		_n=$((_n + 1))
		usleep 50000
	done
	echo_error "  IR-CUT did not reach '$_want' (last read: '$_cur')"
	return 1
}

# True while physical privacy is active (lens parked facing the camera body).
# Night must keep the IR illuminator OFF then, or it would warm the sensor; the
# privacy flow restores it on exit. Read-only check of the persisted privacy flag.
privacy_active() { [ -f /run/physical-privacy.armed ] || grep -q '"active":true' /etc/physical-privacy-state.json 2>/dev/null; }

switch_to_day() {
	# High-frequency dedup: skip a same-mode re-send (no fork of ircut/light/
	# color, no re-pulse of the IR-cut latch) ONLY when WE last applied day. Keyed
	# on APPLIED_FILE (our own verified apply), not prudynt's MODE_FILE, so a stale
	# MODE_FILE can never make this silently no-op a real day switch.
	[ "$applied_mode" = "day" ] && return 0
	echo_info "Switching to day mode..."
	load_controls
	_rc=0

	# Run actuators synchronously and in order (no "&"): a backgrounded child
	# can be cut short when the script exits, and two backgrounded runs can
	# interleave on the shared IR-CUT pins. The singleton above serialises whole
	# invocations; running in-line makes each actuation atomic too. The white
	# light is deliberately left untouched (not day/night-managed). A failed
	# night-vision actuator sets _rc so prudynt does not report a wrong mode.
	if [ "true" = "$day_night_ircut" ] && command_present ircut; then
		echo_info "  set IR-CUT filter"
		set_ircut_verified on || _rc=1
	fi

	if [ "true" = "$day_night_ir850" ] && command_present light; then
		echo_info "  turn IR LED 850nm OFF"
		set_light_verified ir850 off || _rc=1
	fi

	if [ "true" = "$day_night_ir940" ] && command_present light; then
		echo_info "  turn IR LED 940nm OFF"
		set_light_verified ir940 off || _rc=1
	fi

	if [ "true" = "$day_night_color" ] && command_present color; then
		echo_info "  switch to color mode"
		color on
	fi

	# Record the applied mode ONLY on full success (all night-vision actuators
	# verified). On failure leave the marker as-is so prudynt's retry re-actuates
	# instead of dedup-skipping a half-applied switch.
	[ "$_rc" = 0 ] && echo day >"$APPLIED_FILE" 2>/dev/null
	return "$_rc"
}

switch_to_night() {
	# High-frequency dedup: same-mode re-send is a no-op (see switch_to_day).
	[ "$applied_mode" = "night" ] && return 0
	echo_info "Switching to night mode..."
	load_controls
	_rc=0

	if [ "true" = "$day_night_color" ] && command_present color; then
		echo_info "  switch to monochrome mode"
		color off
	fi

	if [ "true" = "$day_night_ircut" ] && command_present ircut; then
		echo_info "  remove IR-CUT filter"
		set_ircut_verified off || _rc=1
	fi

	# IR illuminator is ON in night — EXCEPT while physical privacy is active, when
	# the lens faces the camera body and the IR would warm the sensor: drive it OFF
	# instead (privacy restores it on exit). Runtime only — night's persisted
	# definition is unchanged — and verifying OFF keeps the executor SUCCESSFUL, so
	# prudynt's worker doesn't spin on a forced-night boot-apply during privacy.
	ir_want=on
	privacy_active && ir_want=off

	if [ "true" = "$day_night_ir850" ] && command_present light; then
		echo_info "  IR LED 850nm $ir_want"
		set_light_verified ir850 "$ir_want" || _rc=1
	fi

	if [ "true" = "$day_night_ir940" ] && command_present light; then
		echo_info "  IR LED 940nm $ir_want"
		set_light_verified ir940 "$ir_want" || _rc=1
	fi

	[ "$_rc" = 0 ] && echo night >"$APPLIED_FILE" 2>/dev/null
	return "$_rc"
}

state=$(awk 'NR==1 {print $1}' "$MODE_FILE" 2>/dev/null || echo "day")
# What WE last applied+verified (empty until the first successful switch, and
# after every reboot). Drives the dedup and toggle direction; MODE_FILE ($state)
# is kept only for the read/status reporting below.
applied_mode=$(awk 'NR==1 {print $1}' "$APPLIED_FILE" 2>/dev/null)

rc=0
case "$1" in
	night)
		switch_to_night
		rc=$?
		;;
	day)
		switch_to_day
		rc=$?
		;;
	~ | toggle)
		# Direction off our own last-applied mode (not prudynt's possibly-stale
		# MODE_FILE), so toggle can't wedge the way the dedup could. Unknown/empty
		# (fresh boot) -> treat as day, i.e. toggle to night (matches prior default).
		if [ "night" = "$applied_mode" ]; then
			switch_to_day
		else
			switch_to_night
		fi
		rc=$?
		;;
	\? | read | status)
		echo "$state"
		;;
	*)
		echo_info "Usage: $0 {day|night|toggle|read}"
		echo_info "Current state: $state"
		;;
esac

exit "$rc"
