Subject: [PATCH] daynight: always start stats worker; persist & apply force_mode at startup
Target: prudynt-t @ f4b32289359d176fb0795d9f3735af0bd9d6d2fd (branch stable)

Root causes on T23 / isp_bypass=true builds:
 (A) The DayNightWorker — the sole writer of the daynight.live_* AE telemetry —
     is spawned only when daynight.enabled=true at startup, so forced/manual
     modes leave every daynight.status field at its -1 default for the whole
     process lifetime, and a runtime enable cannot start it. Fix: always start
     the worker; keep automatic switching gated on daynight.enabled inside the
     loop, and gate the initial-mode inference so a disabled engine never
     auto-applies a mode.
 (B) daynight.force_mode was runtime-only (not a persisted config key) and the
     ISP was hard-forced to Day at the end of IMPSystem::init, so a forced mode
     never survived a restart/reboot. Fix: register daynight.force_mode as a
     persisted string key, seed it into the existing one-shot mailbox when the
     worker starts, and apply the configured/forced running mode at launch
     instead of hardcoded Day.

This buys: real AE/gain telemetry in every mode and on every boot; forced
day/night that survives reboots; auto unchanged. Verified to apply cleanly to
the pinned commit (git apply + patch -p1); compiled by CI, not yet bench-built.

diff --git a/src/Config.cpp b/src/Config.cpp
index 1314d29..cd53e4b 100644
--- a/src/Config.cpp
+++ b/src/Config.cpp
@@ -425,6 +425,13 @@ std::vector<ConfigItem<const char *>> CFG::getCharItems() {
       {"daynight.day_bin_path", daynight.day_bin_path, "", validateCharDummy},
       {"daynight.night_bin_path", daynight.night_bin_path, "",
        validateCharDummy},
+      {"daynight.force_mode", daynight.force_mode_cfg, "",
+       [](const char *v) {
+         if (!v || !*v)
+           return true;
+         const std::string s(v);
+         return s == "day" || s == "night";
+       }},
       {"daynight.schedule.start_at", daynight.schedule.start_at, "",
        validateCharDummy},
       {"daynight.schedule.stop_at", daynight.schedule.stop_at, "",
diff --git a/src/Config.hpp b/src/Config.hpp
index 581c7b8..292d5de 100644
--- a/src/Config.hpp
+++ b/src/Config.hpp
@@ -156,6 +156,11 @@ struct _daynight {
   // Manual mode override (set by user via JSON API)
   std::atomic<const char *> force_mode{nullptr};
 
+  // Persisted startup override ("", "day" or "night"); seeded into the
+  // force_mode mailbox once when the worker thread starts so a forced mode
+  // survives restarts/reboots.
+  const char *force_mode_cfg{nullptr};
+
   // Live telemetry populated by the worker - RAW ISP sensor data
   std::atomic<int> live_brightness_percent{-1};
   std::atomic<int> live_ev{-1};
diff --git a/src/DayNightWorker.cpp b/src/DayNightWorker.cpp
index 793b812..0ee1440 100644
--- a/src/DayNightWorker.cpp
+++ b/src/DayNightWorker.cpp
@@ -649,6 +649,17 @@ void *thread_entry(void *arg) {
   int anti_flap_cooldown = 0;
   const int anti_flap_iterations = 30; // ~30 seconds minimum between switches
 
+  // Seed a persisted startup force_mode (daynight.force_mode in the config
+  // file) into the one-shot mailbox; the first loop iteration applies it via
+  // the existing handler below (apply_mode + initial_mode_applied = true,
+  // which also suppresses auto-inference). CAS so a runtime JSON-API request
+  // that raced ahead of us is not clobbered.
+  if (cfg->daynight.force_mode_cfg && *cfg->daynight.force_mode_cfg) {
+    const char *expected = nullptr;
+    cfg->daynight.force_mode.compare_exchange_strong(
+        expected, strdup(cfg->daynight.force_mode_cfg));
+  }
+
   while (!global_shutdown_requested.load(std::memory_order_relaxed)) {
     refresh_daynight_log_level();
 
@@ -724,7 +735,7 @@ void *thread_entry(void *arg) {
     // Apply initial mode if not set - infer from current sensor readings
     // IMPORTANT: This happens regardless of schedule to ensure camera starts in
     // correct mode
-    if (!initial_mode_applied) {
+    if (!initial_mode_applied && cfg->daynight.enabled) {
       DayNightAlgo::Mode initial = DayNightAlgo::Mode::Unknown;
 
       // Infer initial mode from sensor readings to avoid black screen on boot
@@ -843,7 +854,9 @@ void *thread_entry(void *arg) {
     }
 
     const char *mode_str =
-        (current == DayNightAlgo::Mode::Day) ? "day" : "night";
+        (current == DayNightAlgo::Mode::Day)     ? "day"
+        : (current == DayNightAlgo::Mode::Night) ? "night"
+                                                 : "unknown";
     cfg->daynight.live_mode.store(mode_str, std::memory_order_relaxed);
     export_brightness_value(bright_pct, mode_str);
 
diff --git a/src/IMPSystem.cpp b/src/IMPSystem.cpp
index 769ba91..d9a8268 100644
--- a/src/IMPSystem.cpp
+++ b/src/IMPSystem.cpp
@@ -596,9 +596,22 @@ int IMPSystem::init() {
                                        << fps_num << ", " << fps_den << ")");
 #endif
 
-  // Set the ISP to DAY on launch
-  ret = hal::isp::set_running_mode(hal::isp::RunningMode::Day);
-  LOG_DEBUG_OR_ERROR_AND_EXIT(ret, "hal::isp::set_running_mode(Day)");
+  // Apply the configured/forced mode at launch (was: hardcoded Day, which
+  // clobbered cfg->image.running_mode applied earlier in this function and
+  // made forced-night boots flash day). Non-fatal: the daynight worker
+  // re-applies a forced mode on its first iteration anyway.
+  {
+    hal::isp::RunningMode boot_mode =
+        static_cast<hal::isp::RunningMode>(cfg->image.running_mode);
+    const char *fm_cfg = cfg->daynight.force_mode_cfg;
+    if (fm_cfg && strcmp(fm_cfg, "night") == 0) {
+      boot_mode = hal::isp::RunningMode::Night;
+    } else if (fm_cfg && strcmp(fm_cfg, "day") == 0) {
+      boot_mode = hal::isp::RunningMode::Day;
+    }
+    int rm_ret = hal::isp::set_running_mode(boot_mode);
+    LOG_DEBUG_OR_ERROR(rm_ret, "hal::isp::set_running_mode(launch)");
+  }
 #endif // #if !defined(NO_TUNINGS)
 
   return ret;
diff --git a/src/main.cpp b/src/main.cpp
index 11499e5..9659b32 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -726,8 +726,11 @@ int main(int argc, const char *argv[]) {
         LOG_DEBUG_OR_ERROR(ret, "create motion thread");
       }
 
-      if (startup && !daynight_thread_started &&
-          cfg->get<bool>("daynight.enabled")) {
+      // Always start the daynight worker: it is the sole writer of the
+      // live_* AE telemetry (daynight.status reads -1/"unknown" forever if
+      // this thread never starts). Automatic switching remains gated on
+      // cfg->daynight.enabled inside the worker loop.
+      if (startup && !daynight_thread_started) {
         int ret = pthread_create(&daynight_thread, nullptr,
                                  DayNightWorkerNS::thread_entry, nullptr);
         LOG_DEBUG_OR_ERROR(ret, "create daynight thread");
