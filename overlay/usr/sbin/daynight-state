#!/bin/sh
# daynight-state - single source of truth for the persisted auto/day/night mode.
#
# Stores ONE line in /etc/daynight.state:  mode=auto|day|night
#   auto  -> daynight.enabled=true,  force_mode=""      (engine auto-switches)
#   day   -> daynight.enabled=false, force_mode="day"   (forced day)
#   night -> daynight.enabled=false, force_mode="night" (forced night)
# A MISSING or CORRUPT/malformed sidecar falls back to FORCED DAY (the chosen safe
# default for broken persistence) -- the same fallback prudynt's 0015 overlay uses.
#
# Replaces the per-change ~8.5KB rewrite of /etc/prudynt.json for the two
# MQTT-frequent modes: this file is tiny and written atomically (same-dir temp +
# rename + sync), so a power cut never leaves a partial/0-byte state and flash
# wear collapses. Runtime toggles change the LIVE daemon via prudyntctl and
# persist ONLY here (no prudynt.json write). S56ircut, physical-privacy and the
# agent adapter read/write the sidecar through THIS helper, so the on-disk format
# has exactly one authority.
#
# prudynt reads /etc/daynight.state DIRECTLY at config-load (patch 0015 overlays
# CFG::load), so the sidecar IS the boot mode -- no prudynt.json sync needed, no
# post-start correction. `migrate` ENSURES the sidecar holds a valid mode at boot:
# if it is missing or corrupt it seeds FORCED DAY (a valid sidecar is left untouched).
# The legacy prudynt.json daynight keys are dead -- they are NOT consulted.
# `sync-to-config` is a LEGACY/UNWIRED helper from the old rootfs-sync design:
# it is no longer on the boot path (S31prudynt runs only `migrate`), and CI fails
# the build if S31 ever calls it again. It is kept solely as a manual escape hatch
# / rollback aid -- re-wiring it in S31 reverts to the pre-0015 sync model.
#
# Usage: daynight-state get | set <auto|day|night> | migrate | sync-to-config
#   get             prints auto|day|night (missing/corrupt -> day, forced safe default)
#   set M           write-on-change atomic write; rc 0=wrote 1=unchanged 2=fail
#   migrate         ensure a valid sidecar; seed forced 'day' if missing/corrupt (else no-op)
#   sync-to-config  LEGACY/UNWIRED (not on the boot path): write the sidecar mode
#                   into prudynt.json's daynight keys, write-on-change; rc 0=wrote
#                   1=already in sync 2=cannot sync

STATE="/etc/daynight.state"
PRUDYNT_CONFIG="/etc/prudynt.json"
JCT="/usr/bin/jct"

log() { logger -t daynight-state "$*" 2>/dev/null; }

# Atomic, power-safe write (mirrors physical-privacy _w): temp in the SAME dir
# (/etc) so the rename is intra-jffs2 atomic (no EXDEV), sync for durability,
# and on ANY failure delete the temp + return non-zero (never leak a partial).
_write() { # mode
	tmp="${STATE}.tmp.$$"
	if printf 'mode=%s\n' "$1" >"$tmp" 2>/dev/null && mv -f "$tmp" "$STATE"; then
		sync
		return 0
	fi
	rm -f "$tmp" 2>/dev/null
	log "WRITE FAILED (overlay full?) mode=$1 - state NOT persisted"
	return 1
}

# _parse: print the VALID persisted mode (auto|day|night), or NOTHING if the sidecar is
# missing / unreadable / malformed. Robust: first line containing mode=, skip a leading
# quote/space, take the [a-z] run; tolerates quotes/whitespace/CRLF a hand-edited file
# might add. Mirrors prudynt's own CFG::load reader (patch 0015) for the canonical
# `mode=<word>` line THIS helper writes -- both agree on auto|day|night and both fall back
# to forced day on anything else (they may differ only on pathological hand-edits no writer
# emits, which both treat as broken anyway).
_parse() {
	[ -f "$STATE" ] || return 0
	_line=$(grep -m1 'mode=' "$STATE" 2>/dev/null)
	_v=${_line#*mode=}
	_v=$(printf '%s' "$_v" | sed 's/^["[:space:]]*//')
	_m=$(printf '%s' "$_v" | grep -o '^[a-z]*' | head -1)
	case "$_m" in auto | day | night) printf '%s' "$_m" ;; esac
}

get() {
	# A valid persisted mode wins; a missing / corrupt / malformed sidecar falls back to
	# FORCED DAY (the chosen safe default for broken persistence -- same as prudynt's 0015
	# overlay and migrate). Legit mode=auto is preserved, NOT treated as broken.
	_g=$(_parse)
	[ -n "$_g" ] && printf '%s' "$_g" || printf 'day'
}

set_mode() { # auto|day|night
	case "$1" in
		auto | day | night) ;;
		*) echo "daynight-state: invalid mode '$1' (auto|day|night)" >&2; return 2 ;;
	esac
	# Write-on-change compares the REAL on-disk content (_parse), NOT get(): get() maps a
	# missing/corrupt sidecar to the "day" fallback, so comparing get() would make
	# `set day` on a missing/corrupt file look "unchanged" and skip the write. _parse is
	# empty for missing/corrupt, so set always (re)writes and persists in those cases.
	[ "$(_parse)" = "$1" ] && return 1
	_write "$1" && return 0
	return 2
}

migrate() {
	# Reclaim orphan temps left by a power cut / SIGKILL between create and rename.
	# pid-aware so a CONCURRENT writer's in-flight temp is never removed (migrate
	# also runs on watchdog restarts while the agent may be writing): only delete
	# "${STATE}.tmp.<pid>" whose pid is no longer alive.
	for _orph in "${STATE}".tmp.*; do
		[ -e "$_orph" ] || continue
		_op=${_orph##*.}
		case "$_op" in '' | *[!0-9]*) continue ;; esac
		kill -0 "$_op" 2>/dev/null && continue
		rm -f "$_orph" 2>/dev/null
	done
	# The sidecar is the single source of truth; the legacy prudynt.json daynight keys
	# are dead (0015 reads the sidecar directly) and are NOT consulted. If the sidecar
	# already holds a valid auto|day|night, leave it untouched (idempotent -- no write).
	# Otherwise -- missing OR corrupt/malformed -- seed the safe fallback FORCED DAY so a
	# wiped or garbage sidecar self-heals to a known mode (matching get() and prudynt's
	# 0015 overlay).
	[ -n "$(_parse)" ] && return 0
	if _write day; then
		log "daynight-state: sidecar missing/invalid -> seeded forced day"
		return 0
	fi
	return 2
}

# Pre-start sync: make the legacy prudynt.json daynight keys match the sidecar,
# writing ONLY the keys that differ. S31prudynt calls this before launching the
# (proven, unmodified) prudynt so it boots straight into the persisted mode via
# its existing config-load path -- no post-start correction, no wrong-mode window.
#
# Mapping mirrors the agent adapter AND prudynt's boot logic. IMPSystem::init
# applies daynight.force_mode REGARDLESS of daynight.enabled (force_mode drives
# color/mono at boot; an empty force_mode keeps the configured running_mode and
# lets the worker decide), so AUTO MUST clear force_mode or prudynt would boot
# into a stale forced mode:
#   auto  -> force_mode="",      enabled=true
#   day   -> force_mode="day",   enabled=false
#   night -> force_mode="night", enabled=false
#
# rc 0=wrote >=1 key  1=already in sync (no write)  2=cannot sync / write failed
sync_to_config() {
	[ -f "$PRUDYNT_CONFIG" ] && [ -x "$JCT" ] || return 2
	_t=""; command -v timeout >/dev/null 2>&1 && _t="timeout 5"
	_m=$(get)
	case "$_m" in
		day)   _want_fm="day";   _want_en="false" ;;
		night) _want_fm="night"; _want_en="false" ;;
		*)     _want_fm="";      _want_en="true"  ;;
	esac
	# jct may print strings quoted or bare (version-dependent) and bools bare; strip
	# quotes+spaces so the comparison is robust either way against the bare wanted
	# values.
	_cur_fm=$($_t "$JCT" "$PRUDYNT_CONFIG" get daynight.force_mode 2>/dev/null | tr -d '" ')
	_cur_en=$($_t "$JCT" "$PRUDYNT_CONFIG" get daynight.enabled 2>/dev/null | tr -d '" ')
	[ "$_cur_fm" = "$_want_fm" ] && [ "$_cur_en" = "$_want_en" ] && return 1

	_wrote=0
	# force_mode FIRST: it alone drives the boot running_mode, so even if a power
	# cut lands between the two writes the next boot re-runs this and prudynt only
	# ever launches after a completed sync; enabled gates the runtime auto-switch.
	if [ "$_cur_fm" != "$_want_fm" ]; then
		$_t "$JCT" "$PRUDYNT_CONFIG" set daynight.force_mode "$_want_fm" >/dev/null 2>&1 && _wrote=1
	fi
	if [ "$_cur_en" != "$_want_en" ]; then
		$_t "$JCT" "$PRUDYNT_CONFIG" set daynight.enabled "$_want_en" >/dev/null 2>&1 && _wrote=1
	fi

	if [ "$_wrote" != 1 ]; then
		log "pre-start sync: prudynt.json daynight write FAILED (overlay full?) mode=$_m"
		return 2
	fi
	sync
	# Confirm the one tricky op -- clearing force_mode to "" for auto -- actually
	# took, so a silent jct empty-value quirk can't leave prudynt booting forced.
	if [ "$_m" = auto ] && [ "$_cur_fm" != "" ]; then
		_rb=$($_t "$JCT" "$PRUDYNT_CONFIG" get daynight.force_mode 2>/dev/null | tr -d '" ')
		[ -n "$_rb" ] && log "pre-start sync WARNING: force_mode not cleared (got '$_rb'); prudynt may boot forced"
	fi
	log "pre-start sync: prudynt.json daynight <- sidecar (mode=$_m)"
	return 0
}

case "$1" in
	get)            get ;;
	set)            set_mode "$2"; exit $? ;;
	migrate)        migrate; exit $? ;;
	sync-to-config) sync_to_config; exit $? ;;
	*)              echo "Usage: $0 {get|set <auto|day|night>|migrate|sync-to-config}" >&2; exit 1 ;;
esac
exit 0
