#!/bin/sh

show_help() {
	echo "Usage: $0 <type> <mode> [pin#]
Where:
	type	ir | ir850 | ir940 | white | flood
	mode	on | off | toggle | read | gpio
" >&2
	exit 1
}

[ "$#" -lt 1 ] && show_help

# set parameters from cli, if empty
[ -z "$type" ] && type="$1"
[ -z "$mode" ] && mode="${2:-read}"

get_config_pin() {
	local type="$1"
	jct /etc/thingino.json get "gpio.$type.pin" 2>/dev/null ||
		jct /etc/thingino.json get "gpio.$type" 2>/dev/null
}

get_config_active_low() {
	local type="$1"
	jct /etc/thingino.json get "gpio.$type.active_low" 2>/dev/null || echo "false"
}

set_config_pin() {
	local type="$1"
	local pin="$2"
	jct /etc/thingino.json set "gpio.$type.pin" "$pin" 2>/dev/null
}

case "$type" in
	ir)
		pin=$(get_config_pin ir850)
		[ -z "$pin" ] && pin=$(get_config_pin ir940)
		if [ -z "$pin" ]; then
			echo -c 160 -e "GPIO pins for either IR lights are not defined" >&2
			exit 1
		fi
		;;
	ir850 | ir940 | white | flood)
		pin=$(get_config_pin "$type")
		if [ -z "$pin" ] && [ "gpio" != "$mode" ]; then
			echo -c 160 -e "GPIO pin for $type light is not defined" >&2
			exit 1
		fi
		;;
	*)
		echo -c 160 -e "Unknown light type $type" >&2
		show_help
		;;
esac

# Physical-privacy guard: while privacy is active the lens faces the camera body,
# so refuse to switch any IR/white emitter ON (it would warm the sensor). Only the
# turn-ON paths (on/toggle) are blocked; off/read/gpio are always allowed and
# normal (non-privacy) operation is untouched. Keyed on the PERSISTED privacy flag
# so the block also holds at boot, before any /run marker exists. Exits 0 (success)
# so one-shot callers (e.g. S56ircut) don't error; the day/night executor is
# itself privacy-aware (drives IR off in night), so it never hits this path.
case "$type" in
	ir | ir850 | ir940 | white | flood)
		case "$mode" in
			1 | on | ~ | toggle)
				# Refuse if privacy is active by EITHER signal: the /run armed marker
				# (runtime) OR the persisted "active":true (survives reboot before /run
				# exists, and covers an overlay-full entry where the persist failed). The
				# OR means the guard never depends solely on a flash write having succeeded.
				if [ -f /run/physical-privacy.armed ] || grep -q '"active":true' /etc/physical-privacy-state.json 2>/dev/null; then
					echo "light: $type on refused — physical privacy active" >&2
					exit 0
				fi
				;;
		esac
		;;
esac

if [ "true" = "$(get_config_active_low "$type")" ]; then
	pin_on=0
	pin_off=1
else
	pin_on=1
	pin_off=0
fi

case "$mode" in
	0 | off)
		gpio set "$pin" "$pin_off"
		;;
	1 | on)
		gpio set "$pin" "$pin_on"
		;;
	~ | toggle)
		gpio toggle "$pin"
		;;
	\? | read | status)
		if [ "$(gpio value $pin | tr -d '\n')" = "$pin_on" ]; then
			echo -n "1"
		else
			echo -n "0"
		fi
		;;
	gpio | pin)
		mode="gpio"
		new_pin="$3"
		if [ -n "$new_pin" ]; then
			set_config_pin "$type" "$new_pin"
		else
			pin=$(get_config_pin "$type")
			if [ -z "$pin" ]; then
				echo -c 160 -e "GPIO pin is missing" >&2
				show_help
			else
				echo "$pin"
			fi
		fi
		;;
	*)
		echo -c 160 -e "Error: Unknown mode" >&2
		show_help
		;;
esac

exit 0
