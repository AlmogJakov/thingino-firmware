diff --git a/.github/workflows/pt2-build-artifact.yml b/.github/workflows/pt2-build-artifact.yml
new file mode 100644
index 000000000..7da5c123a
--- /dev/null
+++ b/.github/workflows/pt2-build-artifact.yml
@@ -0,0 +1,86 @@
+name: pt2-build-artifact
+# Build ONLY the Sonoff PT2 (T23N / sc2336p / atbm6012bx) firmware and upload the
+# resulting images as a downloadable Actions artifact.
+#
+#   manual only (workflow_dispatch) - no release - no Telegram - no flashing -
+#   no secrets (read-only token) - single board.
+#
+# Same build commands as thingino's CI (make source + make fast), so the prudynt
+# 0001-0013 patches and the overlay/package changes are baked into the image.
+# First run can take ~1-2 h (toolchain + packages); reruns reuse the cache.
+#
+# Run:      Actions -> "pt2-build-artifact" -> Run workflow (pick the pt2-firmware branch).
+# Download: the finished run -> Artifacts -> "pt2-firmware-images".
+
+on:
+  workflow_dispatch:
+
+permissions:
+  contents: read          # read-only: cannot create releases/tags or push anything
+
+env:
+  BOARD: sonoff_pt2_t23n_sc2336p_atbm6012bx
+  FORCE_UNSAFE_CONFIGURE: 1
+  TERM: linux
+  TZ: UTC
+
+jobs:
+  build:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 180
+    container:
+      image: debian:trixie
+    defaults:
+      run:
+        shell: bash
+    steps:
+      - name: Install build dependencies
+        run: |
+          apt-get update
+          apt-get install -y --no-install-recommends --no-install-suggests \
+            autoconf build-essential bc ca-certificates cmake cpio curl file \
+            gawk git jq lzop m4 make p7zip-full perl procps python3 rsync \
+            tzdata u-boot-tools unzip wget
+
+      - name: Set timezone
+        run: ln -sf /usr/share/zoneinfo/UTC /etc/localtime && echo UTC > /etc/timezone
+
+      - name: Checkout firmware (selected branch, with submodules)
+        uses: actions/checkout@v4
+        with:
+          submodules: 'true'      # buildroot/ is a submodule; the build needs it
+          fetch-depth: '0'
+
+      - name: Mark workspace safe for git
+        run: git config --global --add safe.directory "$GITHUB_WORKSPACE"
+
+      - name: Sanity check - prudynt patches present
+        run: |
+          ls -l package/all-patches/prudynt-t/ \
+            || { echo "::error::no prudynt patches in package/all-patches/prudynt-t/ - aborting"; exit 1; }
+
+      - name: Download sources
+        run: BOARD="$BOARD" make source WORKFLOW=1
+
+      - name: Build firmware (full image; bakes patches + overlay + package files)
+        # `make fast` = defconfig + parallel build + pack (thingino's own CI command).
+        run: BOARD="$BOARD" make fast WORKFLOW=1
+
+      - name: Collect built images
+        # Images land under output/<branch>/<camera>-<kernel>-<libc>/images/, not
+        # output/images/. Locate the dir holding the packed firmware and flatten it.
+        run: |
+          BIN=$(find output -type f -name 'thingino-*.bin' 2>/dev/null | head -1)
+          [ -n "$BIN" ] || { echo "::error::build produced no thingino-*.bin under output/"; exit 1; }
+          IMG_DIR=$(dirname "$BIN")
+          echo "images dir: $IMG_DIR"
+          mkdir -p artifacts
+          cp -a "$IMG_DIR"/. artifacts/
+          echo "== artifacts =="; ls -lh artifacts/
+
+      - name: Upload firmware images
+        uses: actions/upload-artifact@v4
+        with:
+          name: pt2-firmware-images
+          path: artifacts/*
+          if-no-files-found: error
